# GitHub Dark - Based on primer/github-vscode-theme
# The default dark theme from GitHub's VS Code extension. ANSI 0-15 match Primer
# exactly; the one derived value is:
#  - selection-background is not a Primer token: the theme defines
#    editor.selectionBackground as the accent blue at 20%, which terminals need
#    opaque. #1c2f45 is ansi.blue (#58a6ff) at 20% flattened onto the #0d1117
#    canvas -- 1.39:1, matching the light theme's 1.33:1. Deliberately ansi.blue
#    and not the theme's chrome accent (#2f81f7, which would give #142744 at a
#    washed-out 1.26:1), so the selection matches the blue the terminal itself
#    prints. Recompute if the background below ever changes.

# ANSI Normal (0-7)
palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4

# ANSI Bright (8-15)
palette = 8=#6e7681
palette = 9=#ffa198
palette = 10=#56d364
palette = 11=#e3b341
palette = 12=#79c0ff
palette = 13=#d2a8ff
palette = 14=#56d4dd
palette = 15=#ffffff

# Base colors
background = #0d1117
foreground = #e6edf3
selection-background = #1c2f45
selection-foreground = #e6edf3
