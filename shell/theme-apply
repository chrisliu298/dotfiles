#!/usr/bin/env sh
# theme-apply — materialize host-local theme config from the active mode.
#
# Single source of truth for turning a light/dark choice into live config,
# shared by the `theme` shell function and dotfiles.sh so the two never drift.
# Writes ONLY host-local files (XDG state dir + the real ~/.config/btop/btop.conf
# plus ~/.codex/config.toml, ~/.claude/settings.json, ~/.claude/themes/{anthropic,openai}.json,
# ~/.config/muse/settings.json, and cswap's settings.json)
# — never a git-tracked file, so switching themes
# can never dirty the tree.
#
# Usage: theme-apply <light|dark>
#
# Derived outputs (all outside git):
#   $STATE_DIR/ghostty.conf        one line, pulled in by ghostty `config-file = ?…`
#   $STATE_DIR/tmux.conf           one line, pulled in by tmux `source-file -q …`
#   $STATE_DIR/starship.toml       full config (STARSHIP_CONFIG target), palette applied
#   ~/.config/btop/btop.conf       full config, generated from the tracked template
#   ~/.codex/config.toml           existing config, TUI theme only
#   ~/.claude/themes/{anthropic,openai}.json  active themes, replaced atomically for live reload
#   ~/.claude/settings.json        existing config, custom:openai unless anthropic is chosen
#   ~/.config/muse/settings.json   existing config, terminal background + theme only
#   cswap settings.json            ui.theme only, via `cswap config set`
#
# Theme *definitions* stay tracked: ghostty/tmux theme files, btop themes/,
# and the starship [palettes.*] tables inside the template.
set -eu

mode=${1:?usage: theme-apply <light|dark>}

# Template paths are overridable so dotfiles.sh can generate straight from the
# repo before the ~/.config symlinks exist (see setup_theme_state).
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
btop_template="${BTOP_TEMPLATE:-$HOME/.config/btop/btop.conf.template}"
starship_template="${STARSHIP_TEMPLATE:-$HOME/.config/starship/starship.toml}"
btop_live="${BTOP_LIVE:-$HOME/.config/btop/btop.conf}"
codex_config="${CODEX_CONFIG:-$HOME/.codex/config.toml}"
claude_config="${CLAUDE_CONFIG:-$HOME/.claude/settings.json}"
claude_theme_dir="${CLAUDE_THEME_DIR:-$HOME/.claude/themes}"
muse_config="${MUSE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/muse/settings.json}"
cswap_bin="${CSWAP_BIN:-cswap}"
# Muse Code keeps its own built-in theme in both modes (see the muse block below).
muse_theme="default"

case "$mode" in
    light) ghostty_theme="OpenAI Light"; btop_theme="openai_light"; tmux_theme="openai_light"; starship_palette="openai_light"; codex_tui_theme="openai-light" ;;
    dark)  ghostty_theme="OpenAI Dark";  btop_theme="openai_dark";  tmux_theme="openai_dark";  starship_palette="openai_dark";  codex_tui_theme="openai-dark" ;;
    *) printf 'theme-apply: invalid mode: %s (want light|dark)\n' "$mode" >&2; exit 2 ;;
esac

mkdir -p "$STATE_DIR"

# ghostty + tmux: tiny override fragments consumed via optional includes.
printf 'theme = %s\n' "$ghostty_theme" > "$STATE_DIR/ghostty.conf.tmp"
mv "$STATE_DIR/ghostty.conf.tmp" "$STATE_DIR/ghostty.conf"

printf 'source-file ~/.config/tmux/themes/%s.conf\n' "$tmux_theme" > "$STATE_DIR/tmux.conf.tmp"
mv "$STATE_DIR/tmux.conf.tmp" "$STATE_DIR/tmux.conf"

# btop: no include mechanism — regenerate the whole live config from the tracked
# template with color_theme rewritten. The live file is host-local (real file in
# a real ~/.config/btop dir), so this write never reaches git.
if [ -f "$btop_template" ]; then
    awk -v repl="color_theme = \"$btop_theme\"" '
        /^color_theme = / { print repl; found = 1; next }
        { print }
        END { if (!found) exit 42 }
    ' "$btop_template" > "$btop_live.tmp" || {
        rm -f "$btop_live.tmp"
        printf 'theme-apply: btop template has no color_theme line\n' >&2
        exit 1
    }
    mv "$btop_live.tmp" "$btop_live"
fi

# Claude watches the selected custom theme file, so stable theme names let
# running sessions follow mode changes. Both families stay selectable in /theme;
# stage and replace each file in the same dir.
mkdir -p "$claude_theme_dir"
for claude_family in anthropic:Anthropic openai:OpenAI; do
    claude_slug=${claude_family%%:*}
    claude_theme_src="$claude_theme_dir/$claude_slug-$mode.json"
    claude_theme_tmp="$claude_theme_dir/.$claude_slug.json.theme.$$"
    jq --arg name "${claude_family#*:} (follows theme)" \
        'if type == "object" then .name = $name else error("Claude theme must be a JSON object") end' \
        "$claude_theme_src" > "$claude_theme_tmp" || {
        rm -f "$claude_theme_tmp"
        printf 'theme-apply: failed to stage Claude theme from %s\n' "$claude_theme_src" >&2
        exit 1
    }
    mv "$claude_theme_tmp" "$claude_theme_dir/$claude_slug.json"
done

# Keep the host-local settings intact. A /theme choice of either stable family
# survives mode switches; anything else gets the OpenAI default.
if [ -f "$claude_config" ]; then
    claude_tmp="${claude_config}.theme.$$"
    jq 'if type != "object" then error("Claude settings must be a JSON object")
        elif .theme == "custom:anthropic" or .theme == "custom:openai" then .
        else .theme = "custom:openai" end' \
        "$claude_config" > "$claude_tmp" || {
        rm -f "$claude_tmp"
        printf 'theme-apply: failed to stage Claude settings from %s\n' "$claude_config" >&2
        exit 1
    }
    chmod 600 "$claude_tmp"
    mv "$claude_tmp" "$claude_config"
fi

# starship: no include mechanism — regenerate the STARSHIP_CONFIG target from the
# tracked template with the palette rewritten. Palettes stay defined in the template.
if [ -f "$starship_template" ]; then
    awk -v repl="palette = '$starship_palette'" '
        /^palette = / { print repl; found = 1; next }
        { print }
        END { if (!found) exit 42 }
    ' "$starship_template" > "$STATE_DIR/starship.toml.tmp" || {
        rm -f "$STATE_DIR/starship.toml.tmp"
        printf 'theme-apply: starship template has no palette line\n' >&2
        exit 1
    }
    mv "$STATE_DIR/starship.toml.tmp" "$STATE_DIR/starship.toml"
fi

# Pin the matching custom syntax theme: terminal-background probing can time out
# over SSH and pick the wrong mode. Codex Desktop follows macOS independently.
if [ -f "$codex_config" ]; then
    codex_tmp="${codex_config}.theme.$$"
    awk \
        -v tui_repl="theme = \"$codex_tui_theme\"" '
        /^\[[^]]+\][[:space:]]*$/ {
            if (in_tui && !found_tui_key) print tui_repl
            in_tui = ($0 == "[tui]")
            if (in_tui) found_tui_section = 1
            print
            next
        }
        in_tui && /^theme[[:space:]]*=/ {
            print tui_repl
            found_tui_key = 1
            next
        }
        { print }
        END {
            if (in_tui && !found_tui_key) print tui_repl
            if (!found_tui_section) {
                print ""
                print "[tui]"
                print tui_repl
            }
        }
    ' "$codex_config" > "$codex_tmp" || {
        rm -f "$codex_tmp"
        printf 'theme-apply: failed to stage Codex config from %s\n' "$codex_config" >&2
        exit 1
    }
    chmod 600 "$codex_tmp"
    mv "$codex_tmp" "$codex_config"
fi

# Muse reads its theme and terminal background from settings.json at startup
# (running sessions keep theirs). Pin the background over the startup probe,
# which can miss under tmux/SSH, and keep its own built-in `default` theme —
# not the OpenAI palette. The pinned background is what makes that default
# theme resolve to its light/dark variant in step with `theme`.
if [ -f "$muse_config" ]; then
    muse_tmp="${muse_config}.theme.$$"
    jq --arg bg "$mode" --arg theme "$muse_theme" \
        'if type == "object" then .tui = ((.tui // {}) + {terminal_background: $bg, theme: $theme}) else error("Muse settings must be a JSON object") end' \
        "$muse_config" > "$muse_tmp" || {
        rm -f "$muse_tmp"
        printf 'theme-apply: failed to stage Muse settings from %s\n' "$muse_config" >&2
        exit 1
    }
    chmod 600 "$muse_tmp"
    mv "$muse_tmp" "$muse_config"
fi

# cswap's `auto` theme probes the terminal background, which never reaches the
# outer terminal under tmux, so pin ui.theme instead. Its own CLI owns the
# platform-specific settings path and file modes. An optional tool: warn only.
if command -v "$cswap_bin" >/dev/null 2>&1; then
    "$cswap_bin" config set ui.theme "$mode" >/dev/null ||
        printf 'theme-apply: failed to set cswap ui.theme=%s\n' "$mode" >&2
fi
