#!/usr/bin/env sh
# theme-apply — materialize host-local theme config from the active mode.
#
# Single source of truth for turning a light/dark choice into live config,
# shared by the `theme` shell function and dotfiles.sh so the two never drift.
# Writes ONLY host-local files (XDG state dir + the real ~/.config/btop/btop.conf
# plus ~/.codex/config.toml and ~/.claude/themes/) — never a
# git-tracked file — so switching
# themes can never dirty the tree.
#
# Usage: theme-apply <light|dark>
#
# Derived outputs (all outside git):
#   $STATE_DIR/ghostty.conf        one line, pulled in by ghostty `config-file = ?…`
#   $STATE_DIR/tmux.conf           one line, pulled in by tmux `source-file -q …`
#   $STATE_DIR/starship.toml       full config (STARSHIP_CONFIG target), palette applied
#   ~/.config/btop/btop.conf       full config, generated from the tracked template
#   ~/.codex/config.toml           existing config, TUI theme only
#   ~/.claude/themes/dotfiles.json       full theme, copied from the tracked definition
#
# Theme *definitions* stay tracked: ghostty/tmux theme files, btop themes/,
# agents/claude/themes/{light,dark}.json, and the starship [palettes.*]
# tables inside the template.
set -eu

mode=${1:?usage: theme-apply <light|dark>}

# Template paths are overridable so dotfiles.sh can generate straight from the
# repo before the ~/.config symlinks exist (see setup_theme_state).
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-theme"
btop_template="${BTOP_TEMPLATE:-$HOME/.config/btop/btop.conf.template}"
starship_template="${STARSHIP_TEMPLATE:-$HOME/.config/starship/starship.toml}"
btop_live="${BTOP_LIVE:-$HOME/.config/btop/btop.conf}"
codex_config="${CODEX_CONFIG:-$HOME/.codex/config.toml}"
# Claude Code has no ~/.claude/themes symlink to read definitions through, so this
# points straight at the repo (dotfiles.sh overrides it during a fresh install).
claude_themes="${CLAUDE_THEMES:-$HOME/dotfiles/agents/claude/themes}"
claude_live="${CLAUDE_LIVE_THEME:-$HOME/.claude/themes/dotfiles.json}"

case "$mode" in
    light) ghostty_theme="GitHub Light"; btop_theme="github_light"; tmux_theme="github_light"; starship_palette="github_light"; codex_tui_theme="catppuccin-latte" ;;
    dark)  ghostty_theme="GitHub Dark";  btop_theme="github_dark";  tmux_theme="github_dark";  starship_palette="github_dark";  codex_tui_theme="catppuccin-mocha" ;;
    *) printf 'theme-apply: invalid mode: %s (want light|dark)\n' "$mode" >&2; exit 2 ;;
esac

mkdir -p "$STATE_DIR"

# ghostty + tmux: tiny override fragments consumed via optional includes.
printf 'theme = %s\n' "$ghostty_theme" > "$STATE_DIR/ghostty.conf.tmp"
mv "$STATE_DIR/ghostty.conf.tmp" "$STATE_DIR/ghostty.conf"

printf 'source-file ~/.config/tmux/themes/%s.conf\n' "$tmux_theme" > "$STATE_DIR/tmux.conf.tmp"
mv "$STATE_DIR/tmux.conf.tmp" "$STATE_DIR/tmux.conf"

# btop: no include mechanism — regenerate the whole live config from the tracked
# template with color_theme rewritten. The live file is host-local (real file in
# a real ~/.config/btop dir), so this write never reaches git.
if [ -f "$btop_template" ]; then
    awk -v repl="color_theme = \"$btop_theme\"" '
        /^color_theme = / { print repl; found = 1; next }
        { print }
        END { if (!found) exit 42 }
    ' "$btop_template" > "$btop_live.tmp" || {
        rm -f "$btop_live.tmp"
        printf 'theme-apply: btop template has no color_theme line\n' >&2
        exit 1
    }
    mv "$btop_live.tmp" "$btop_live"
fi

# starship: no include mechanism — regenerate the STARSHIP_CONFIG target from the
# tracked template with the palette rewritten. Palettes stay defined in the template.
if [ -f "$starship_template" ]; then
    awk -v repl="palette = '$starship_palette'" '
        /^palette = / { print repl; found = 1; next }
        { print }
        END { if (!found) exit 42 }
    ' "$starship_template" > "$STATE_DIR/starship.toml.tmp" || {
        rm -f "$STATE_DIR/starship.toml.tmp"
        printf 'theme-apply: starship template has no palette line\n' >&2
        exit 1
    }
    mv "$STATE_DIR/starship.toml.tmp" "$STATE_DIR/starship.toml"
fi

# Codex's automatic TUI theme depends on a short terminal-background probe. That
# can time out over SSH and fall back to the dark theme on a light terminal, so
# pin the same light/dark defaults Codex would choose adaptively. Desktop follows
# macOS independently, so leave its user-controlled appearance setting untouched.
if [ -f "$codex_config" ]; then
    codex_tmp="${codex_config}.theme.$$"
    awk \
        -v tui_repl="theme = \"$codex_tui_theme\"" '
        /^\[[^]]+\][[:space:]]*$/ {
            if (in_tui && !found_tui_key) print tui_repl
            in_tui = ($0 == "[tui]")
            if (in_tui) found_tui_section = 1
            print
            next
        }
        in_tui && /^theme[[:space:]]*=/ {
            print tui_repl
            found_tui_key = 1
            next
        }
        { print }
        END {
            if (in_tui && !found_tui_key) print tui_repl
            if (!found_tui_section) {
                print ""
                print "[tui]"
                print tui_repl
            }
        }
    ' "$codex_config" > "$codex_tmp" || {
        rm -f "$codex_tmp"
        printf 'theme-apply: failed to stage Codex config from %s\n' "$codex_config" >&2
        exit 1
    }
    chmod 600 "$codex_tmp"
    mv "$codex_tmp" "$codex_config"
fi

# Claude Code pins its `theme` setting to the custom theme "dotfiles" and lets
# this script swap what that theme *is*. Unlike the btop and
# starship templates — which can legitimately be absent mid-install — these
# definitions live in the repo and the pinned setting references them
# unconditionally, so a missing one is a hard error: the agent would fail to
# load the theme and fall back to its own default palette while dotfiles.sh
# still logged the apply as successful.
install_agent_theme() {
    src="$1" live="$2" label="$3"
    if [ ! -f "$src" ]; then
        printf 'theme-apply: %s theme definition missing: %s\n' "$label" "$src" >&2
        exit 1
    fi
    mkdir -p "$(dirname "$live")"
    cp "$src" "$live.tmp" || {
        rm -f "$live.tmp"
        printf 'theme-apply: failed to stage %s theme from %s\n' "$label" "$src" >&2
        exit 1
    }
    mv "$live.tmp" "$live"
}

# claude: Claude Code's `theme = auto` does follow
# the terminal, but it only picks between Anthropic's own palettes — and the
# light one paints user messages rgb(240,240,240), indistinguishable from the
# #fafafa canvas at 1.09:1. Fixing that needs a custom theme, and
# selecting one pins the light/dark base, so settings.json pins `theme` to
# "custom:dotfiles" and the mode picks which definition that slug resolves to.
# Each file overrides only the user-message band and its hover, tinted to the
# mode's family; everything else stays on Anthropic's palette. Claude watches
# ~/.claude/themes and re-resolves base+overrides on change, so running sessions
# repaint without a restart.
install_agent_theme "$claude_themes/$mode.json" "$claude_live" claude
