#!/usr/bin/env python3
"""User-operated availability control.

  prs [show]                       current state and pending counts
  prs away [NOTE]                  mark away (note is informational)
  prs back                         mark present
  prs questions                   all queued questions
  prs clear [KEY ...]              drop queued questions by 待问 key (no KEY: all)

Passive hook modes are internal. They never instruct an agent to use this CLI.
State and the configured project/session allowlists live in XDG_STATE_HOME/presence
(default ~/.local/state/presence). Only the configured R2V sessions are affected.
"""
import fcntl, glob, json, os, sys, time, uuid
from datetime import datetime

ROOT = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "presence")
STATE = os.path.join(ROOT, "state.json")
QDIR = os.path.join(ROOT, "questions")
PROJECTS = os.path.join(ROOT, "projects")
SESSIONS = os.path.join(ROOT, "sessions")
SEEN = os.path.join(ROOT, "seen")
SEEN_GRACE = 15 * 60
QUESTION_HEADER = "待问-"
PEER_PREFIXES = ("<cross-session-message", "<task-notification", "<teammate-message",
                 "<agent-message", "[peer]", "Another Claude session")


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def load():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {"state": "present", "since": None}


def save(s):
    os.makedirs(ROOT, exist_ok=True)
    tmp = f"{STATE}.{os.getpid()}.tmp"
    json.dump(s, open(tmp, "w"), ensure_ascii=False, indent=1)
    os.replace(tmp, STATE)


def qpath(sid):
    return os.path.join(QDIR, f"{sid}.json")


def qload(sid):
    try:
        return json.load(open(qpath(sid)))
    except (OSError, ValueError):
        return {"items": []}


def qupdate(sid, change):
    """Read-modify-write a session's queue under a lock, since parallel tool calls and their hooks hit the same
    file. An emptied queue is removed. Returns (queue, change's result)."""
    os.makedirs(QDIR, exist_ok=True)
    with open(os.path.join(QDIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        q = qload(sid)
        out = change(q)
        if q["items"]:
            tmp = f"{qpath(sid)}.{os.getpid()}.tmp"
            json.dump(q, open(tmp, "w"), ensure_ascii=False, indent=1)
            os.replace(tmp, qpath(sid))
        elif os.path.exists(qpath(sid)):
            os.remove(qpath(sid))
    return q, out


def render(request):
    """Everything the native question carried, so the user can re-read it and the agent can re-ask it intact."""
    header = request.get("header", "")
    lines = [request.get("question", "") + ("（多选）" if request.get("multiSelect") else "")]
    if header and not header.startswith(QUESTION_HEADER):
        lines.append(f"  标签：{header}")
    for option in request.get("options", []):
        lines.append(f"  - {option.get('label', '')}" + (f"：{option['description']}" if option.get("description") else ""))
        if option.get("preview"):
            lines += ["      " + line for line in option["preview"].splitlines()]
    return "\n".join(lines)


def qadd(sid, questions, label=None):
    """A deferred correction updates its existing identity instead of forking it."""
    def change(q):
        q["label"] = label or q.get("label") or session_name(sid)
        ids = []
        for request in questions:
            question, header = request.get("question", ""), request.get("header", "")
            key = header[len(QUESTION_HEADER):] if header.startswith(QUESTION_HEADER) else None
            item = next((i for i in q["items"] if key and i.get("key") == key), None)
            if item is None:
                item = next((i for i in q["items"] if i.get("question", i["text"].split("（选项：")[0]) == question), None)
            if item is None:
                item = {"id": max((i["id"] for i in q["items"]), default=0) + 1, "at": now()}
                q["items"].append(item)
            item.update(text=render(request), question=question, request=request)
            ids.append(item["id"])
        question_keys(q)
        return ids
    return qupdate(sid, change)[1]


def question_keys(q):
    """Persist identity across rewording, including queues created by older hooks."""
    used = {i["key"] for i in q["items"] if i.get("key")}
    for item in q["items"]:
        if not item.get("key"):
            key = uuid.uuid4().hex[:8]
            while key in used:
                key = uuid.uuid4().hex[:8]
            item["key"] = key
            used.add(key)


def qlist(q):
    return "\n".join(f"#{i['id']}（{i['at'][5:16].replace('T', ' ')}）"
                     f"{QUESTION_HEADER + i['key'] + '：' if i.get('key') else ''}{i['text']}" for i in q["items"])


def session_name(sid):
    for f in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            record = json.load(open(f))
        except (OSError, ValueError):
            continue
        if record.get("sessionId") == sid and record.get("name"):
            return record["name"]
    return f"{os.path.basename(os.getcwd())}（{(sid or '?')[:8]}）"


def in_scope(cwd, sid):
    try:
        allowed = {line.strip() for line in open(SESSIONS) if line.strip()}
        if sid not in allowed:
            return False
        roots = [os.path.realpath(os.path.expanduser(l.strip())) for l in open(PROJECTS) if l.strip()]
    except OSError:
        return False
    cwd = os.path.realpath(cwd or ".")
    return any(cwd == r or cwd.startswith(r + os.sep) for r in roots)


def mark_seen(sid, at=None):
    os.makedirs(SEEN, exist_ok=True)
    at = time.time() if at is None else at
    path = os.path.join(SEEN, sid)
    with open(os.path.join(SEEN, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            if at <= float(open(path).read()):
                return
        except (OSError, ValueError):
            pass
        tmp = f"{path}.{os.getpid()}.tmp"
        open(tmp, "w").write(str(at))
        os.replace(tmp, path)


def input_time(record):
    try:
        return datetime.fromisoformat(record["timestamp"].replace("Z", "+00:00")).timestamp()
    except (KeyError, ValueError):
        return None


def seen_recently(sid, event=None):
    # Some clients write the current prompt after UserPromptSubmit runs. At
    # PreToolUse it is available; recover the input time, not a fresh 15 minutes.
    record = prompt_record(event) if event else None
    if record and human_record(record):
        at = input_time(record)
        if at is not None and 0 <= time.time() - at < SEEN_GRACE:
            mark_seen(sid, at)
    try:
        return 0 <= time.time() - float(open(os.path.join(SEEN, sid)).read()) < SEEN_GRACE
    except (OSError, ValueError):
        return False


def describe(s):
    word = "用户已标记离开" if s["state"] == "away" else "用户在"
    since = f"（{s['since']} 起）" if s.get("since") else ""
    note = f"，备注：{s['note']}" if s.get("note") else ""
    return f"{word}{since}{note}"


def pending_summary():
    queues = [json.load(open(f)) for f in sorted(glob.glob(os.path.join(QDIR, "*.json")))]
    rows = [f"{q.get('label')} {len(q['items'])} 条" for q in queues]
    return f"\n待问：{'；'.join(rows)}（到对应窗口说话时才会问）" if rows else "\n没有待问问题"


def transcript_lines(transcript, limit=None):
    """Walk backwards without loading the session; pending prompts use a bounded peek."""
    position = transcript.seek(0, os.SEEK_END)
    remaining = position if limit is None else min(position, limit)
    carry = b""
    while remaining:
        size = min(65536, remaining)
        position -= size
        remaining -= size
        transcript.seek(position)
        lines = (transcript.read(size) + carry).split(b"\n")
        carry = lines.pop(0)
        if not position:
            lines.insert(0, carry)
        yield from reversed(lines)


def prompt_record(event, pending=False):
    """Correlate a legacy hook's current prompt, never its wording."""
    path, prompt_id = event.get("transcript_path"), event.get("prompt_id")
    if not path or not prompt_id:
        return None
    try:
        with open(path, "rb") as transcript:
            for line in transcript_lines(transcript, 1024 * 1024 if pending else None):
                # Wire payloads and tool output can be large and need no JSON decoding.
                if not any(t in line[:1024] for t in (b'"type":"user"', b'"type": "user"',
                                                     b'"type":"attachment"', b'"type": "attachment"')):
                    continue
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if record.get("sessionId") != event.get("session_id"):
                    continue
                if record.get("type") == "attachment":
                    attachment = record.get("attachment", {})
                    if attachment.get("type") != "queued_command":
                        continue
                    if pending and record_prompt(record).strip() != text_prompt(event.get("prompt", "")).strip():
                        continue
                    if not pending and not human_record(record):
                        continue
                    return record
                if record.get("type") != "user":
                    continue
                content = record.get("message", {}).get("content", [])
                if not isinstance(content, str) and not any(b.get("type") == "text" for b in content):
                    continue
                if not record.get("promptSource") and not record.get("wakeupSource"):
                    continue
                if record.get("promptId") == prompt_id:
                    if pending and record_prompt(record).strip() != text_prompt(event.get("prompt", "")).strip():
                        return None
                    return record
                # Reaching an earlier input must not grant the current turn its origin.
                return None
    except OSError:
        pass
    return None


def text_prompt(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def record_prompt(record):
    if record.get("type") == "attachment":
        return text_prompt(record.get("attachment", {}).get("prompt", ""))
    return text_prompt(record.get("message", {}).get("content", []))


def human_record(record):
    if record.get("type") == "attachment":
        attachment = record.get("attachment", {})
        human = (attachment.get("type") == "queued_command" and attachment.get("commandMode") == "prompt"
                 and (attachment.get("origin") or {}).get("kind") == "human")
    else:
        human = (not record.get("isMeta") and not record.get("wakeupSource") and record.get("turnOrigin") == "human"
                 and record.get("promptSource") in ("typed", "queued", "suggestion_accepted"))
    return human and not record_prompt(record).strip().startswith(PEER_PREFIXES)


def hook_prompt():
    event = json.load(sys.stdin)
    prompt = text_prompt(event.get("prompt", "")).strip()
    if (not in_scope(event.get("cwd") or os.getcwd(), event.get("session_id")) or os.environ.get("CODEX_REVIEW_SUBAGENT_ACTIVE") == "1"
            or prompt.startswith(PEER_PREFIXES)):
        return
    source = event.get("source")
    record = prompt_record(event, pending=True) if source is None else None
    human = source == "user" if source is not None else record is not None and human_record(record)
    if (source is not None or record is not None) and not human:
        return
    sid = event.get("session_id") or "?"
    at = time.time() if source == "user" else input_time(record) if record else None
    checked_in = human and at is not None and 0 <= time.time() - at < SEEN_GRACE
    if checked_in:
        mark_seen(sid, at)
    s, q = load(), qload(sid)
    if s["state"] == "away" and checked_in:
        print(f"[用户在场状态] 用户仍标记离开；本窗口已核验真人输入，自该输入起 {SEEN_GRACE // 60} 分钟内可照常提问。其他窗口状态不变，无需主动修改状态。")
    if q["items"]:
        q, _ = qupdate(sid, question_keys)
        print(f"[待问] 本会话有 {len(q['items'])} 条待问：\n{qlist(q)}\n"
              "先处理用户当前消息，再核对哪些问题仍成立；过期或能自己定的跳过，其余用 AskUserQuestion 问用户。"
              "重问已有待问项时，header 原样使用该项的「待问-xxxxxxxx」标识，question 正文可以改写；新问题不要借用旧标识。"
              "队列由程序维护，无需调用命令；收到有效回答后相应条目自动移除。")


def hook_ask():
    event = json.load(sys.stdin)
    s = load()
    if not in_scope(event.get("cwd"), event.get("session_id")) or s["state"] != "away" or seen_recently(event.get("session_id") or "?", event):
        return
    questions = event.get("tool_input", {}).get("questions", [])
    ids = qadd(event.get("session_id") or "?", questions, event.get("session_title"))
    reason = (f"{describe(s)}。这些问题已记进本会话的待问清单（{' '.join(f'#{i}' for i in ids)}），"
              "他回来在本窗口说话时再问，现在不要重复调用提问工具，也不需要调用命令维护队列。"
              "在已有授权内按可逆默认推进，记好所用默认；没有安全默认就停在对应步骤，继续其他独立工作。")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}, ensure_ascii=False))


def hook_post():
    event = json.load(sys.stdin)
    if not in_scope(event.get("cwd"), event.get("session_id")) or event.get("tool_name") != "AskUserQuestion":
        return
    response = event.get("tool_response")
    answers = response.get("answers", {}) if isinstance(response, dict) else {}
    if not isinstance(answers, dict):
        return
    answered = {q for q, answer in answers.items() if answer}
    if answered:
        # The native tool returns answers keyed by its current wording. Its header
        # carries our stable identity, so changing that wording cannot orphan a queue item.
        questions = event.get("tool_input", {}).get("questions", [])
        tagged = {i["question"]: i["header"][len(QUESTION_HEADER):] for i in questions
                  if i.get("question") in answered and i.get("header", "").startswith(QUESTION_HEADER)}
        keys = set(tagged.values())
        exact = answered - tagged.keys()
        qupdate(event["session_id"], lambda q: q.update(items=[i for i in q["items"]
                if i.get("key") not in keys and i.get("question", i["text"].split("（选项：")[0]) not in exact]))


def switch(s, state, note):
    """Repeating the current state changes nothing, so the first window's time and note stand."""
    if s["state"] == state:
        return print(f"已经是这个状态，没有改动。{describe(s)}{pending_summary()}")
    s = {"state": state, "since": now(), "note": note}
    save(s)
    print(describe(s) + pending_summary())


def clear(keys):
    """Drop the named items across every queue, or all queues; an unknown key changes nothing."""
    sids = [os.path.basename(f)[:-5] for f in sorted(glob.glob(os.path.join(QDIR, "*.json")))]
    known = {i.get("key") for sid in sids for i in qload(sid)["items"]}
    if missing := [k for k in keys if k not in known]:
        sys.exit(f"没有这些待问项：{'、'.join(QUESTION_HEADER + k for k in missing)}（用 prs questions 查看）")
    def drop(q):
        kept = [i for i in q["items"] if keys and i.get("key") not in keys]
        removed, q["items"] = len(q["items"]) - len(kept), kept
        return removed
    removed = sum(qupdate(sid, drop)[1] for sid in sids)
    print(f"已清除 {removed} 条。{pending_summary()}")


def main(argv):
    cmd = argv[0] if argv else "show"
    if cmd == "hook-prompt":
        return hook_prompt()
    if cmd == "hook-ask":
        return hook_ask()
    if cmd == "hook-post":
        return hook_post()
    if any(os.environ.get(key) for key in ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "CODEX_THREAD_ID", "CODEX_SESSION_ID", "CODEX_TOOL_CALL_ID", "CURSOR_AGENT")):
        sys.exit("此入口仅供用户终端主动调用；agent 不能操作。")
    if cmd == "questions":
        for f in sorted(glob.glob(os.path.join(QDIR, "*.json"))):
            q = json.load(open(f))
            print(f"== {q.get('label')}\n{qlist(q)}")
        return
    if cmd == "clear":
        return clear([a.removeprefix(QUESTION_HEADER) for a in argv[1:]])
    if cmd == "away":
        return switch(load(), "away", " ".join(argv[1:]) or None)
    if cmd == "back":
        return switch(load(), "present", None)
    if cmd != "show":
        sys.exit(__doc__)
    print(describe(load()) + pending_summary())


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except Exception as e:  # a broken hook must never block a prompt or a question
        if sys.argv[1:2] and sys.argv[1].startswith("hook-"):
            print(f"[用户在场状态] hook error: {type(e).__name__}", file=sys.stderr)
            sys.exit(0)
        raise
