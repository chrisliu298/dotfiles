#!/bin/zsh
# Bring the *-r2v, adapt-clf and thesis tmux sessions, each running Claude Code or the
# Antigravity CLI (agy), back after a reboot.
# Claude Code records every live process in ~/.claude/sessions/<pid>.json with
# its tmux pane ("name:@win.%pane") and conversation id; a live agy holds its
# conversation's ~/.gemini/antigravity-cli/presence/<id>.lock open. `save` copies the
# entries of those sessions into a snapshot, and `restore` recreates each missing
# session in its cwd and resumes that exact conversation.
# LaunchAgents that dotfiles.sh installs run `restore` at login
# (local.tmux-persist-restore) and `save` every 5 minutes (local.tmux-persist-save).
# Usage: tmux-persist            show those sessions and their snapshot entries
#        tmux-persist save       refresh the snapshot from live Claude processes
#        tmux-persist restore    recreate snapshot sessions that are not running
#        tmux-persist restart [--effort <level>] <name>...|--all
#                                restart the Claude or agy in running sessions
#                                (--all: every session running one, e.g. after an
#                                update), resuming the same conversations
#                                with a message saying they were restarted (only
#                                to a Claude that left work to recover), on the
#                                model and effort agent-models.conf sets (else
#                                the ones each runs now; --effort: <level>)
#        tmux-persist stale      sessions whose Claude predates the installed
#                                version (shows "Restart to update"): tpr $(tps)
set -euo pipefail

STATE=${TMUX_PERSIST_STATE:-$HOME/.local/state/tmux-persist}
SESSIONS_DIR=${TMUX_PERSIST_CLAUDE_SESSIONS:-$HOME/.claude/sessions}
PROJECTS=${TMUX_PERSIST_CLAUDE_PROJECTS:-$HOME/.claude/projects}
# --model: `claude --resume` otherwise takes the model of the transcript's last
# reply, which is Opus 5 after a refusal fallback even once /model switched back.
# It names the default; a session running another model keeps that one (live_of).
LAUNCH=${TMUX_PERSIST_LAUNCH:-claude --dangerously-skip-permissions --model claude-opus-5-5 --resume}
# agy through the shell's `g` (shell/.functions), which adds the proxy agy needs here; with
# no --model it starts on agy's default (Gemini 4 Neon at high).
AGY_LAUNCH=${TMUX_PERSIST_AGY_LAUNCH:-g --conversation}
AGY_PRESENCE=${TMUX_PERSIST_AGY_PRESENCE:-$HOME/.gemini/antigravity-cli/presence}
PATTERN='(*-r2v|adapt-clf|thesis)'
SNAP=$STATE/snapshot  # name<TAB>cwd<TAB>sessionId<TAB>effort<TAB>flags<TAB>model<TAB>agent (trailing ones may be
                      # absent; agent is "agy" for an agy session, else a Claude one)
# Launch flags a session needs again on every launch: a channel (e.g. the Feishu
# avatar bot's) only pushes messages into a Claude started with them. Each takes
# one or more values, which must not contain spaces (ps drops the quoting).
# `--effort` is kept on its own, as restart can override it.
KEEP=(--mcp-config --dangerously-load-development-channels --channels)
# The first message of a restarted conversation: inspect restored state before
# recreating missing work; %s is the session id.
RESTARTED="这个会话刚被重启了（tmux-persist restart）：Claude 进程已被替换，对话已恢复。先检查后台任务、Monitor、cron、scheduled wakeup 和 loop 的现状；定时任务先用 CronList 核对，只恢复仍需要且缺失的工作，保留已有频率，不重复创建。子代理上下文在 ~/.claude/projects/*/%s/subagents/，没有 \"finished\":true 的 meta.json 记录未完成工作，用 SendMessage 按文件名里的 agentId 继续，不要重新起。然后继续当前任务。"
# agy's first message after every restart and restore, passed with -i: unlike Claude, agy loses all its
# background tasks and schedules with the process, and keeps its subagents only as idle ones, so it always
# has work to recover. Registration and project memory need no step: agy's session start brings them.
AGY_RESTARTED="这个会话刚被重启（tmux-persist）：agy 进程已替换，对话已恢复。重启会停掉所有后台任务和 schedule 定时任务，它们不会自己恢复；子代理还在，但都处于空闲，手上的活已中断。先用 manage_task list 看现状，用 ps 确认没有残留的常驻进程实例，再按你的记录或交接文档重建仍需要的常驻进程和定时任务，保留原来的频率，不要重复提交；用 manage_subagents 找到有未完成工作的子代理，给它发消息接着做，不要另起新的。然后继续当前任务。"
SELF=${0:A}
# A tmux server this starts (restore, the first command after kill-server) gives its environment to
# every session; a caller's proxy (agy's g sets one) would then send them all, and the internal
# platforms they reach DIRECT, through it. Each agent sets its own proxy where it needs one.
unset http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
# The cross-machine mailbox channel (agents/claude/peer, see its README): every launch gets it,
# so each session can be messaged from another Mac. Empty disables it.
PEER_MCP=${TMUX_PERSIST_PEER_MCP-${SELF:h:h}/agents/claude/peer/mcp.json}
# The model and level set for each session (agents/claude/agent-models.conf, which
# opus-repin also reads); they outrank what a session runs now.
AGENT_MODELS=${AGENT_MODELS:-$HOME/.claude/agent-models.conf}

# launchd starts us with a bare PATH.
path=(/opt/homebrew/bin /usr/local/bin $path)
tmux_() { tmux ${TMUX_PERSIST_SOCKET:+-L} ${TMUX_PERSIST_SOCKET:-} "$@"; }

persisted() { [[ $1 == ${~PATTERN} ]]; }

# A migrated identity stays excluded even if an old snapshot still names it.
# Prepared entries also block upgrade restarts while the owner saves its work.
# The Rex entries ("role<TAB>sessionId" of each non-tmux one) are read once per process,
# as one jq per entry and session made a restart wait seconds per session.
NATIVE=() NATIVE_READ=0
native_owned() {
    local -a files
    local out row
    if (( ! NATIVE_READ )); then
        files=("${REX_CLAUDE_STATE:-$HOME/.local/state/rex-claude}"/sessions/*.json(N))
        if (( ${#files} )); then
            out=$(jq -r 'select(.transport != "tmux") | [.role // "", .sessionId // ""] | @tsv' $files) \
                || { print -u2 'tmux-persist: unreadable Rex ownership; refusing operation'; exit 1; }
            NATIVE=(${(f)out})
        fi
        NATIVE_READ=1
    fi
    for row in $NATIVE; do
        [[ ${row%%$'\t'*} == "$1" || ( -n ${2:-} && ${row#*$'\t'} == "$2" ) ]] && return 0
    done
    return 1
}

# claudes: "name<TAB>pid<TAB>pane<TAB>cwd<TAB>sessionId<TAB>version" for each
# live Claude in a tmux pane. The session file keeps the session name from Claude's start, so
# the current name comes from the pane id, which survives a rename. Only the pane's own
# Claude counts (the pane process or its child): one a tool started (agent-team, a nested
# `claude -p`) inherits TMUX_PANE and records the same pane, and restarting the pane with
# its id would kill the real one. A pid counts only while it is still the process that
# started at the file's procStart (UTC, as ps prints it with TZ=UTC), so a pid reused after
# a reboot is not mistaken for the old Claude. One ps and one jq serve every file, as a few
# processes per file made listing take seconds; BSD ps by absolute path.
claudes() {
    local -A owner panepid parent started
    local -a w files
    local row pid start tmux cwd id ver name pane f
    for row in ${(f)"$(tmux_ list-panes -a -F '#{pane_id} #{pane_pid} #{session_name}' 2>/dev/null || true)"}; do
        pane=${row%% *}; row=${row#* }
        panepid[$pane]=${row%% *}; owner[$pane]=${row#* }
    done
    for row in ${(f)"$(TZ=UTC LC_ALL=C /bin/ps -axo pid=,ppid=,lstart=)"}; do
        w=(${=row}); parent[${w[1]}]=${w[2]}; started[${w[1]}]="${w[3,4]} ${w[5]#0} ${w[6,-1]}"
    done
    files=("$SESSIONS_DIR"/*.json(N))
    (( ${#files} )) || return 0
    # The files joined by NULs, so a file caught mid-write skips only itself.
    while IFS=$'\t' read -r pid start tmux cwd id ver; do
        [[ -n $tmux ]] && name=${owner[${tmux##*.}]:-} && [[ -n $name ]] || continue
        w=(${=start})  # e.g. "Tue Nov 08 01:49:24 2026", the day padded or not
        [[ ${started[$pid]:-} == "${w[1,2]} ${w[3]#0} ${w[4,-1]}" ]] || continue
        [[ $pid == "${panepid[${tmux##*.}]}" || ${parent[$pid]} == "${panepid[${tmux##*.}]}" ]] || continue
        native_owned "$name" "$id" && continue
        print -r -- "$name"$'\t'"$pid"$'\t'"${tmux##*.}"$'\t'"$cwd"$'\t'"$id"$'\t'"$ver"$'\t'claude
    done < <(for f in $files; do print -rn -- "$(<$f)"$'\0'; done \
        | jq -rRs 'split("\u0000")[] | fromjson? | [.pid, .procStart, .tmux // "", .cwd, .sessionId, .version // ""] | @tsv')
}

# agys: the same rows ("...<TAB><TAB>agy", no version) for each agy that is a pane's process or its
# child. The conversation comes from the presence lock it holds open, which follows /clear.
agys() {
    local -A owner pane_of conv dir
    local row pid ppid pane f
    local -a w locks=("$AGY_PRESENCE"/*.lock(N))
    (( ${#locks} )) || return 0
    for row in ${(f)"$(lsof -Fpn -- $locks 2>/dev/null || true)"}; do
        case $row in p*) pid=${row#p} ;; n*) conv[$pid]=${${row#n}:t:r} ;; esac
    done
    (( ${#conv} )) || return 0
    for row in ${(f)"$(lsof -a -d cwd -Fpn -p ${(j:,:)${(k)conv}} 2>/dev/null || true)"}; do
        case $row in p*) pid=${row#p} ;; n*) dir[$pid]=${row#n} ;; esac
    done
    for row in ${(f)"$(tmux_ list-panes -a -F '#{pane_pid} #{pane_id} #{session_name}' 2>/dev/null || true)"}; do
        w=(${=row}); pane_of[${w[1]}]=${w[2]}; owner[${w[1]}]=${w[3,-1]}
    done
    for pid in ${(k)conv}; do
        ppid=$(/bin/ps -o ppid= -p $pid 2>/dev/null) || continue
        pane=${pane_of[$pid]:-${pane_of[${ppid// /}]:-}}
        f=${pane_of[$pid]:+$pid}; f=${f:-${ppid// /}}
        [[ -n $pane ]] || continue
        native_owned "${owner[$f]}" "${conv[$pid]}" && continue
        print -r -- "${owner[$f]}"$'\t'"$pid"$'\t'"$pane"$'\t'"${dir[$pid]:-}"$'\t'"${conv[$pid]}"$'\t\t'agy
    done
}

# agents: claudes and agys.
agents() { claudes; agys; }

# with_peer <flags>: <flags> plus the peer channel: its config after any --mcp-config values
# and server:peer after any development channels, each added with its flag when absent.
with_peer() {
    local -a w=(${=1})
    local f v i
    # A copy run from elsewhere resolves PEER_MCP to a missing file, and Claude refuses to start
    # over one missing --mcp-config (autoeval-bot-r2v, 2026-11-17 14:53): drop the channel instead.
    [[ -n $PEER_MCP && -f $PEER_MCP ]] || { print -r -- "$1"; return; }
    for f v in --mcp-config $PEER_MCP --dangerously-load-development-channels server:peer; do
        (( ${w[(Ie)$v]} )) && continue
        i=${w[(i)$f]}
        if (( i > ${#w} )); then w+=("$f" "$v"); continue; fi
        while (( i < ${#w} )) && [[ ${w[i+1]} != -* ]]; do (( ++i )); done
        w[i]=("${w[i]}" "$v")
    done
    print -r -- "${w[*]}"
}

# live_of <id>: "<model>\t<level>" of the last main-thread request in conversation
# <id>'s transcript, or nothing. A model or level set with /model or /effort shows up
# only there: the launch args keep naming what the session started on (2026-11-18
# Training ran claude-fable-5-2 at high while its argv still said claude-opus-5-5),
# so a restart off the args alone silently moves the session back. Transcripts reach
# hundreds of MB, so only the tail is read; the request records are near the end, and
# a session with none yet falls back to the launch args.
live_of() {
    local t line
    for t in "$PROJECTS"/*/$1.jsonl(N); do
        line=$(tail -c ${TMUX_PERSIST_TAIL:-4000000} "$t" 2>/dev/null |
            grep -a '^{"type":"api-request",' | grep -a -F '"querySource":"repl_main_thread"' | tail -1) || true
        [[ -n $line ]] || return 0
        print -r -- "$line" | jq -r '[(.params.model // ""), (.params.output_config.effort // "")] | @tsv' 2>/dev/null || true
        return 0
    done
}

# live_model <id> / live_effort <id>: one field of live_of, validated. A model id must
# look like one (a relaunch on a bad --model would not start), and the 1M-context
# suffix is not part of it. The safeguards fallback is not reported: a session that a
# refusal moved there runs it only until opus-repin gets it back, and a relaunch is
# the other way out, so it must start on the model $LAUNCH names, not on the fallback.
live_model() {
    local m=${"$(live_of "$1")"%%$'\t'*}
    m=${m%\[1m\]}
    [[ $m == ${TMUX_PERSIST_FALLBACK_MODEL:-claude-opus-5} ]] && return 0
    [[ $m == claude-?* && $m != *[^a-z0-9.-]* ]] && print -r -- "$m" || true # no extendedglob here
}
live_effort() {
    local e=${"$(live_of "$1")"##*$'\t'}
    [[ $e == (low|medium|high|xhigh|max) ]] && print -r -- "$e" || true
}

# configured <name>: "<model>\t<level>" agent-models.conf sets for session <name>
# (the level empty for "-"), or nothing.
# <agent> claude or agy: a model for the other kind (the file not yet updated after a switch) is left
# out, as that agent would refuse it, and noted; the level still applies.
configured() {
    [[ -f $AGENT_MODELS ]] || return 0
    local row=$(awk -v n="$1" '$1 == n { print $2 "\t" ($3 == "-" ? "" : $3); exit }' "$AGENT_MODELS")
    local model=${row%%$'\t'*}
    if [[ -n $model ]] && { [[ $2 == agy && $model == claude-* ]] || [[ $2 != agy && $model != claude-* ]]; }; then
        note "agent-models.conf: $1 runs $2, so its model $model is ignored"
        row=$'\t'${row#*$'\t'}
    fi
    print -r -- "$row"
}

# model_of <pid>: the model Claude <pid> was launched with, or nothing.
model_of() {
    local -a w
    w=(${(s: :)"$(/bin/ps -o command= -p "$1" 2>/dev/null)"})
    local i=${w[(i)--model]}
    if (( i < ${#w} )); then print -r -- "${w[i+1]}"; return; fi
    i=${w[(I)--model=*]}
    (( i )) && print -r -- "${w[i]#--model=}" || true
}

# launch_with <model>: $LAUNCH with its --model replaced by <model>. Leaves $LAUNCH
# alone when it names no model (a TMUX_PERSIST_LAUNCH override) or <model> is empty.
launch_with() {
    [[ -n $1 ]] || { print -r -- "$LAUNCH"; return; }
    local -a w=(${=LAUNCH})
    local i=${w[(i)--model]}
    (( i < ${#w} )) && w[i+1]=$1
    print -r -- "${w[*]}"
}

# effort_of <pid>: the level Claude <pid> was launched with (--effort <level> or
# --effort=<level>), or nothing. A resumed Claude otherwise starts at the settings'
# level, so a session launched with its own level would lose it on restart.
effort_of() {
    local -a w
    w=(${(s: :)"$(/bin/ps -o command= -p "$1" 2>/dev/null)"})
    local i=${w[(i)--effort]}
    if (( i < ${#w} )); then print -r -- "${w[i+1]}"; return; fi
    i=${w[(I)--effort=*]}
    (( i )) && print -r -- "${w[i]#--effort=}" || true
}

# flags_of <pid>: the KEEP flags Claude <pid> was launched with, each as
# "<flag> <value>..." (from <flag> <value>... or <flag>=<value>), or nothing.
# A flag's values run to the next word starting with "-", as Claude parses them.
flags_of() {
    local -a w out
    local i f
    w=(${(s: :)"$(/bin/ps -o command= -p "$1" 2>/dev/null)"})
    for (( i = 1; i <= ${#w}; i++ )); do
        for f in $KEEP; do
            if [[ ${w[i]} == "$f" ]]; then
                out+=("$f")
                while (( i < ${#w} )) && [[ ${w[i+1]} != -* ]]; do out+=("${w[++i]}"); done
                break
            elif [[ ${w[i]} == "$f="* ]]; then
                out+=("$f" "${w[i]#$f=}"); break
            fi
        done
    done
    print -r -- "${out[*]}"
}

# accept_dev_channels <target> <flags> <tenths>: a Claude launched with
# --dangerously-load-development-channels first shows a full-screen warning
# whose default is "1. I am using this for local development"; the session was
# already confirmed by hand on its first launch, so press Enter on that dialog
# alone: it counts only as the bottom of the screen (a resumed conversation
# quoting it has its input box below). Up to 3 presses until it goes away; gives
# up after <tenths> of a second without it, noting so in $STATE/dialog.log.
on_dev_dialog() {
    local screen
    local -a last
    screen=$(tmux_ capture-pane -p -t "$1" 2>/dev/null) || return 1
    last=(${(f)"$(print -r -- "$screen" | grep -v '^[[:space:]]*$' | tail -4)"})
    [[ $screen == *'WARNING: Loading development channels'* && ${last[1]} == *'Channels: '* \
        && ${last[2]} == *'❯ 1. I am using this for local development'* && ${last[3]} == *'2. Exit'* \
        && ${last[4]} == *'Enter to confirm'* ]]
}
accept_dev_channels() {
    [[ " $2 " == *" --dangerously-load-development-channels "* ]] || return 0
    local tries=0 presses wait
    until on_dev_dialog "$1"; do
        (( ++tries < $3 )) || { note "no development channel dialog in $1"; return 0; }
        sleep 0.1
    done
    for (( presses = 0; presses < 3; presses++ )); do
        tmux_ send-keys -t "$1" Enter
        for (( wait = 0; wait < 30; wait++ )); do on_dev_dialog "$1" || return 0; sleep 0.1; done
    done
    note "development channel dialog in $1 still open after 3 presses"
}
note() { print -u2 "tmux-persist: $1"; mkdir -p "$STATE"; print -r -- "$(date '+%F %T') $1" >> "$STATE/dialog.log"; }

# entry <cwd> <id> <effort> <flags> <model> [agy]: a snapshot row without its name, trailing
# empty columns dropped.
entry() {
    local row="$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"
    if [[ ${6:-} == agy ]]; then row+=$'\t'"$5"$'\t'agy; elif [[ -n $5 ]]; then row+=$'\t'"$5"; fi
    print -r -- "$row"
}

# launch_line <agent> <id> <model> <effort> [<flags> [<msg>]]: the command that resumes conversation
# <id>. agy takes no Claude model as its default and none of the KEEP flags, and always gets
# $AGY_RESTARTED, last, as -i takes the next word.
launch_line() {
    if [[ $1 == agy ]]; then
        print -r -- "$AGY_LAUNCH $2${3:+ --model $3}${4:+ --effort $4} -i ${(qq)AGY_RESTARTED}"
    else
        print -r -- "$(launch_with "$3") $2${6:+ ${(qq)6}}${4:+ --effort $4}${5:+ $5}"
    fi
}

save() {
    local -A rows
    local -a open
    local name pid pane cwd id ver effort flags model agent
    open=(${(f)"$(tmux_ list-sessions -F '#S' 2>/dev/null || true)"})
    # No tmux server (e.g. at boot, before restore) says nothing about which
    # sessions were closed, so the snapshot stays as it is.
    (( ${#open} )) || return 0
    # Keep the last known entry for a session that is still open but whose
    # Claude is not running now; a session closed on purpose drops out.
    # A doubled tab makes it a non-whitespace separator, so an empty effort
    # column does not collapse and shift the flags into it.
    [[ -f $SNAP ]] && while IFS=$'\t\t' read -r name cwd id effort flags model agent; do
        persisted "$name" && (( ${open[(Ie)$name]} )) || continue
        native_owned "$name" "$id" && continue
        rows[$name]=$(entry "$cwd" "$id" "$effort" "$flags" "$model" "$agent")
    done < "$SNAP"
    while IFS=$'\t\t' read -r name pid pane cwd id ver agent; do
        persisted "$name" || continue
        if [[ $agent == agy ]]; then  # agy keeps no readable record of a /model change
            rows[$name]=$(entry "$cwd" "$id" "$(effort_of "$pid")" "" "$(model_of "$pid")" agy)
            continue
        fi
        # What the session runs now outranks what it was launched with.
        effort=$(live_effort "$id"); [[ -n $effort ]] || effort=$(effort_of "$pid")
        model=$(live_model "$id"); [[ -n $model ]] || model=$(model_of "$pid")
        rows[$name]=$(entry "$cwd" "$id" "$effort" "$(flags_of "$pid")" "$model")
    done < <(agents)
    mkdir -p "$STATE"
    for name in ${(ko)rows}; do print -r -- "$name"$'\t'"${rows[$name]}"; done > "$SNAP.tmp"
    mv "$SNAP.tmp" "$SNAP"
}

restore() {
    local name cwd id effort flags model agent conf
    [[ -f $SNAP ]] || return 0
    while IFS=$'\t\t' read -r name cwd id effort flags model agent; do  # \t\t: see save
        persisted "$name" || continue
        native_owned "$name" "$id" && continue
        tmux_ has-session -t "=$name" 2>/dev/null && continue
        conf=$(configured "$name" "$agent")
        model=${${conf%%$'\t'*}:-$model} effort=${${conf#*$'\t'}:-$effort}
        [[ -d $cwd ]] || cwd=$HOME
        [[ $agent == agy ]] || flags=$(with_peer "$flags")
        # Typed into the pane's shell, so exiting the agent leaves a shell behind.
        tmux_ new-session -d -s "$name" -c "$cwd"
        tmux_ send-keys -t "=$name:" C-u "$(launch_line "$agent" "$id" "$model" "$effort" "$flags")" Enter
        # At login the network and several Claudes start together: wait up to 5 min.
        accept_dev_channels "=$name:" "$flags" ${TMUX_PERSIST_DIALOG_WAIT:-3000} &
        print -r -- "restored $name"
    done < "$SNAP"
    wait
}

# owes <pid> <id>: true when Claude <pid>, about to be replaced, leaves work that only
# the restart message gets the new one to pick up; one with none resumes without it, so
# it is not handed a turn for nothing. That work is a turn, background shell or Monitor,
# or permission prompt in progress (any status but idle; a session file without one
# counts too), or a subagent written to since the process started without
# "finished":true in its meta (background subagents leave the status idle). Session
# crons and wakeups are not: Claude re-arms them itself on --resume.
owes() {
    local st started m j
    local -a mt
    IFS=$'\t' read -r st started < <(jq -r '[.status // "", .startedAt // 0] | @tsv' "$SESSIONS_DIR/$1.json") || return 0
    [[ $st == idle ]] || return 0
    started=$(( started / 1000 ))
    zmodload -F zsh/stat b:zstat
    for m in "$PROJECTS"/*/$2/subagents/*.meta.json(N); do
        j=${m%.meta.json}.jsonl; [[ -f $j ]] || j=$m
        zstat -A mt +mtime -- "$j"
        (( mt[1] >= started )) || continue
        jq -e '.finished == true' "$m" > /dev/null || return 0
    done
    return 1
}

# restart_pane <shell> <name> <pid> <pane> <cwd> <id> <agent>: same pane, window and
# attached clients; only the pane's process is replaced, by a login <shell>.
# The new Claude gets the model agent-models.conf sets, else the one the old one
# runs or was launched with; EFFORT if set, else the configured level, else the
# old one's live or launch level; and the old one's KEEP flags. The message, when
# the old one owes work, goes right after the id, as a flag taking several values
# would swallow it.
restart_pane() {
    local shell=$1 name=$2 pid=$3 pane=$4 cwd=$5 id=$6 agent=$7 tries=0 msg= flags=
    local conf=$(configured "$name" "$agent")
    local effort=${EFFORT:-${conf#*$'\t'}} model=${conf%%$'\t'*}
    [[ -n $effort ]] || effort=$(live_effort "$id")
    [[ -n $model ]] || model=$(live_model "$id")
    [[ -n $effort ]] || effort=$(effort_of "$pid")
    [[ -n $model ]] || model=$(model_of "$pid")
    [[ -d $cwd ]] || cwd=$HOME
    # Read before the old Claude goes: its status is gone with it. agy has neither.
    if [[ $agent != agy ]]; then
        flags=$(with_peer "$(flags_of "$pid")")
        if owes "$pid" "$id"; then printf -v msg "$RESTARTED" "$id"; fi
    fi
    # An explicit command, since a bare respawn reruns the pane's original one.
    tmux_ respawn-pane -k -t "$pane" -c "$cwd" "exec ${(q)shell} -l"
    # Two Claude processes must not share one transcript.
    while kill -0 "$pid" 2>/dev/null; do
        (( ++tries < 100 )) || { kill -9 "$pid" 2>/dev/null; break; }
        sleep 0.1
    done
    # C-u first: whatever the user typed into the new shell meanwhile would prefix the line.
    tmux_ send-keys -t "$pane" C-u "$(launch_line "$agent" "$id" "$model" "$effort" "$flags" "$msg")" Enter
    accept_dev_channels "$pane" "$flags" ${TMUX_PERSIST_DIALOG_WAIT:-600}
    print -r -- "restarted $name ($pane)"
}

# restart <name>...|--all: every Claude in the named sessions (--all: in every session
# running one), in parallel. Nothing restarts unless each session has one. The Claudes
# are listed once, as listing them takes seconds.
restart() {
    local name row pid pane cwd id ver agent v shell missing=0
    local -a all rows found env
    all=(${(f)"$(agents)"})
    if [[ $* == --all ]]; then
        set -- ${(u)all%%$'\t'*}
        (( $# )) || { print -u2 "tmux-persist: no running Claude or agy in any session"; exit 1; }
    fi
    for name in "$@"; do
        found=("${(@M)all:#$name$'\t'*}")
        if (( ! ${#found} )); then
            print -u2 "tmux-persist: no running Claude or agy in session $name"; missing=1; continue
        fi
        rows+=("${found[@]}")
    done
    (( ! missing )) || exit 1
    # Run from inside one of those Claudes (e.g. via `!`), killing its pane would
    # kill us, so the tmux server reruns us outside the pane.
    for row in "${rows[@]}"; do
        IFS=$'\t\t' read -r name pid pane cwd id ver agent <<< "$row"
        [[ $pane == "${TMUX_PANE:-}" ]] || continue
        env=(TMUX_PANE=)
        for v in ${(k)parameters[(I)TMUX_PERSIST_*]}; do env+=("$v=${(P)v}"); done
        tmux_ run-shell -b "${(j: :)${(q)env}} ${(q)SELF} restart ${EFFORT:+--effort ${(q)EFFORT}} ${(j: :)${(q)@}}"
        return
    done
    shell=$(tmux_ show -gv default-shell)
    for row in "${rows[@]}"; do
        IFS=$'\t\t' read -r name pid pane cwd id ver agent <<< "$row"
        restart_pane "$shell" "$name" "$pid" "$pane" "$cwd" "$id" "$agent" &
    done
    wait
}

# stale: each session with a Claude older than the installed one, the version
# Claude Code's "Restart to update" refers to.
stale() {
    local name pid pane cwd id ver installed
    installed=${TMUX_PERSIST_VERSION:-$(claude --version)}
    installed=${installed%% *}  # "2.1.310 (Claude Code)"
    claudes | while IFS=$'\t\t' read -r name pid pane cwd id ver agent; do
        [[ -n $ver && $ver != "$installed" ]] && print -r -- "$name"
    done | sort -u
}

case ${1:-} in
    save) save ;;
    restore) restore ;;
    stale) stale ;;
    restart) shift
        EFFORT=
        if [[ ${1:-} == --effort ]]; then
            EFFORT=${2:-}; shift $(( $# < 2 ? $# : 2 ))
            [[ -n $EFFORT ]] || set --  # --effort without a level
        fi
        # --all alone is expanded by restart, which lists the Claudes anyway.
        [[ $* != --all ]] && (( ${@[(Ie)--all]} )) && set --  # --all with session names
        (( $# >= 1 )) || { print -u2 "usage: tmux-persist restart [--effort <level>] <session>...|--all"; exit 2; }
        restart "$@" ;;
    '') [[ -f $SNAP ]] && cat "$SNAP"
        for name in ${(f)"$(tmux_ list-sessions -F '#S' 2>/dev/null || true)"}; do
            persisted "$name" || continue
            [[ -f $SNAP ]] && cut -f1 "$SNAP" | grep -qxF -- "$name" && continue
            print -r -- "$name"$'\t(no snapshot)'
        done ;;
    *) print -u2 "usage: tmux-persist [save|restore|stale|restart [--effort <level>] <session>...|--all]"; exit 2 ;;
esac
