#!/bin/zsh
# Bring the *-r2v, adapt-clf and thesis tmux sessions, each running Claude Code, back after a reboot.
# Claude Code records every live process in ~/.claude/sessions/<pid>.json with
# its tmux pane ("name:@win.%pane") and conversation id; `save` copies the entries
# of those sessions into a snapshot, and `restore` recreates each missing
# session in its cwd and resumes that exact conversation.
# LaunchAgents that dotfiles.sh installs run `restore` at login
# (local.tmux-persist-restore) and `save` every 5 minutes (local.tmux-persist-save).
# Usage: tmux-persist            show those sessions and their snapshot entries
#        tmux-persist save       refresh the snapshot from live Claude processes
#        tmux-persist restore    recreate snapshot sessions that are not running
#        tmux-persist restart [--effort <level>] <name>...|--all
#                                restart the Claude in running sessions (--all:
#                                every session running one, e.g. after an
#                                update), resuming the same conversations
#                                with a message saying they were restarted, at the
#                                effort each was launched with (or <level>)
#        tmux-persist stale      sessions whose Claude predates the installed
#                                version (shows "Restart to update"): tpr $(tps)
set -euo pipefail

STATE=${TMUX_PERSIST_STATE:-$HOME/.local/state/tmux-persist}
SESSIONS_DIR=${TMUX_PERSIST_CLAUDE_SESSIONS:-$HOME/.claude/sessions}
# --model: `claude --resume` otherwise takes the model of the transcript's last
# reply, which is Opus 5 after a refusal fallback even once /model switched back.
LAUNCH=${TMUX_PERSIST_LAUNCH:-claude --dangerously-skip-permissions --model claude-opus-5-5 --resume}
PATTERN='(*-r2v|adapt-clf|thesis)'
SNAP=$STATE/snapshot  # name<TAB>cwd<TAB>sessionId<TAB>effort<TAB>flags (empty: none given)
# Launch flags a session needs again on every launch: a channel (e.g. the Feishu
# avatar bot's) only pushes messages into a Claude started with them. Each takes
# one or more values, which must not contain spaces (ps drops the quoting).
# `--effort` is kept on its own, as restart can override it.
KEEP=(--mcp-config --dangerously-load-development-channels --channels)
# The first message of a restarted conversation: inspect restored state before
# recreating missing work; %s is the session id.
RESTARTED="这个会话刚被重启了（tmux-persist restart）：Claude 进程已被替换，对话已恢复。先检查后台任务、Monitor、cron、scheduled wakeup 和 loop 的现状；定时任务先用 CronList 核对，只恢复仍需要且缺失的工作，保留已有频率，不重复创建。子代理上下文在 ~/.claude/projects/*/%s/subagents/，没有 \"finished\":true 的 meta.json 记录未完成工作，用 SendMessage 按文件名里的 agentId 继续，不要重新起。然后继续当前任务。"
SELF=${0:A}
# The cross-machine mailbox channel (agents/claude/peer, see its README): every launch gets it,
# so each session can be messaged from another Mac. Empty disables it.
PEER_MCP=${TMUX_PERSIST_PEER_MCP-${SELF:h:h}/agents/claude/peer/mcp.json}

# launchd starts us with a bare PATH.
path=(/opt/homebrew/bin /usr/local/bin $path)
tmux_() { tmux ${TMUX_PERSIST_SOCKET:+-L} ${TMUX_PERSIST_SOCKET:-} "$@"; }

persisted() { [[ $1 == ${~PATTERN} ]]; }

# A migrated identity stays excluded even if an old snapshot still names it.
# Prepared entries also block upgrade restarts while the owner saves its work.
native_owned() {
    local f code
    for f in "${REX_CLAUDE_STATE:-$HOME/.local/state/rex-claude}"/sessions/*.json(N); do
        if jq -e --arg name "$1" --arg id "${2:-}" \
            '(.role == $name or (.sessionId == $id and $id != "")) and .transport != "tmux"' "$f" >/dev/null; then
            return 0
        else
            code=$?
            (( code == 1 )) || { print -u2 'tmux-persist: unreadable Rex ownership; refusing operation'; exit 1; }
        fi
    done
    return 1
}

# True when <pid> is still the process that started at <procStart> (UTC), so a
# pid reused after a reboot is not mistaken for the old Claude.
# BSD date/ps by absolute path: a GNU coreutils date may lead PATH.
alive() {
    local started now was
    started=$(LC_ALL=C /bin/ps -o lstart= -p "$1" 2>/dev/null) || return 1
    now=$(LC_ALL=C /bin/date -j -f '%a %b %d %T %Y' "${(j: :)${(z)started}}" +%s) || return 1
    was=$(LC_ALL=C /bin/date -u -j -f '%a %b %d %T %Y' "$2" +%s) || return 1
    [[ $now == "$was" ]]
}

# claudes: "name<TAB>pid<TAB>pane<TAB>cwd<TAB>sessionId<TAB>version" for each
# live Claude in a tmux pane. The session file keeps the session name from Claude's start, so
# the current name comes from the pane id, which survives a rename. Only the pane's own
# Claude counts (the pane process or its child): one a tool started (agent-team, a nested
# `claude -p`) inherits TMUX_PANE and records the same pane, and restarting the pane with
# its id would kill the real one.
claudes() {
    local -A owner panepid
    local row f pid start tmux cwd id ver name pane
    for row in ${(f)"$(tmux_ list-panes -a -F '#{pane_id} #{pane_pid} #{session_name}' 2>/dev/null || true)"}; do
        pane=${row%% *}; row=${row#* }
        panepid[$pane]=${row%% *}; owner[$pane]=${row#* }
    done
    for f in "$SESSIONS_DIR"/*.json(N); do
        IFS=$'\t' read -r pid start tmux cwd id ver < <(
            jq -r '[.pid, .procStart, .tmux // "", .cwd, .sessionId, .version // ""] | @tsv' "$f") || continue
        [[ -n $tmux ]] && name=${owner[${tmux##*.}]:-} && [[ -n $name ]] || continue
        alive "$pid" "$start" || continue
        [[ $pid == "${panepid[${tmux##*.}]}" \
            || $(/bin/ps -o ppid= -p "$pid" | tr -d ' ') == "${panepid[${tmux##*.}]}" ]] || continue
        native_owned "$name" "$id" && continue
        print -r -- "$name"$'\t'"$pid"$'\t'"${tmux##*.}"$'\t'"$cwd"$'\t'"$id"$'\t'"$ver"
    done
}

# with_peer <flags>: <flags> plus the peer channel: its config after any --mcp-config values
# and server:peer after any development channels, each added with its flag when absent.
with_peer() {
    local -a w=(${=1})
    local f v i
    [[ -n $PEER_MCP ]] || { print -r -- "$1"; return; }
    for f v in --mcp-config $PEER_MCP --dangerously-load-development-channels server:peer; do
        (( ${w[(Ie)$v]} )) && continue
        i=${w[(i)$f]}
        if (( i > ${#w} )); then w+=("$f" "$v"); continue; fi
        while (( i < ${#w} )) && [[ ${w[i+1]} != -* ]]; do (( ++i )); done
        w[i]=("${w[i]}" "$v")
    done
    print -r -- "${w[*]}"
}

# effort_of <pid>: the level Claude <pid> was launched with (--effort <level> or
# --effort=<level>), or nothing. A resumed Claude otherwise starts at the settings'
# level, so a session launched with its own level would lose it on restart.
effort_of() {
    local -a w
    w=(${(s: :)"$(/bin/ps -o command= -p "$1" 2>/dev/null)"})
    local i=${w[(i)--effort]}
    if (( i < ${#w} )); then print -r -- "${w[i+1]}"; return; fi
    i=${w[(I)--effort=*]}
    (( i )) && print -r -- "${w[i]#--effort=}" || true
}

# flags_of <pid>: the KEEP flags Claude <pid> was launched with, each as
# "<flag> <value>..." (from <flag> <value>... or <flag>=<value>), or nothing.
# A flag's values run to the next word starting with "-", as Claude parses them.
flags_of() {
    local -a w out
    local i f
    w=(${(s: :)"$(/bin/ps -o command= -p "$1" 2>/dev/null)"})
    for (( i = 1; i <= ${#w}; i++ )); do
        for f in $KEEP; do
            if [[ ${w[i]} == "$f" ]]; then
                out+=("$f")
                while (( i < ${#w} )) && [[ ${w[i+1]} != -* ]]; do out+=("${w[++i]}"); done
                break
            elif [[ ${w[i]} == "$f="* ]]; then
                out+=("$f" "${w[i]#$f=}"); break
            fi
        done
    done
    print -r -- "${out[*]}"
}

# accept_dev_channels <target> <flags> <tenths>: a Claude launched with
# --dangerously-load-development-channels first shows a full-screen warning
# whose default is "1. I am using this for local development"; the session was
# already confirmed by hand on its first launch, so press Enter on that dialog
# alone: it counts only as the bottom of the screen (a resumed conversation
# quoting it has its input box below). Up to 3 presses until it goes away; gives
# up after <tenths> of a second without it, noting so in $STATE/dialog.log.
on_dev_dialog() {
    local screen
    local -a last
    screen=$(tmux_ capture-pane -p -t "$1" 2>/dev/null) || return 1
    last=(${(f)"$(print -r -- "$screen" | grep -v '^[[:space:]]*$' | tail -4)"})
    [[ $screen == *'WARNING: Loading development channels'* && ${last[1]} == *'Channels: '* \
        && ${last[2]} == *'❯ 1. I am using this for local development'* && ${last[3]} == *'2. Exit'* \
        && ${last[4]} == *'Enter to confirm'* ]]
}
accept_dev_channels() {
    [[ " $2 " == *" --dangerously-load-development-channels "* ]] || return 0
    local tries=0 presses wait
    until on_dev_dialog "$1"; do
        (( ++tries < $3 )) || { note "no development channel dialog in $1"; return 0; }
        sleep 0.1
    done
    for (( presses = 0; presses < 3; presses++ )); do
        tmux_ send-keys -t "$1" Enter
        for (( wait = 0; wait < 30; wait++ )); do on_dev_dialog "$1" || return 0; sleep 0.1; done
    done
    note "development channel dialog in $1 still open after 3 presses"
}
note() { print -u2 "tmux-persist: $1"; mkdir -p "$STATE"; print -r -- "$(date '+%F %T') $1" >> "$STATE/dialog.log"; }

# live <name>: "pid<TAB>pane<TAB>cwd<TAB>sessionId<TAB>version" for each live Claude in <name>.
live() {
    local name rest
    claudes | while IFS=$'\t' read -r name rest; do
        [[ $name == "$1" ]] || continue
        print -r -- "$rest"
    done
}

save() {
    local -A rows
    local -a open
    local name pid pane cwd id ver effort flags
    open=(${(f)"$(tmux_ list-sessions -F '#S' 2>/dev/null || true)"})
    # No tmux server (e.g. at boot, before restore) says nothing about which
    # sessions were closed, so the snapshot stays as it is.
    (( ${#open} )) || return 0
    # Keep the last known entry for a session that is still open but whose
    # Claude is not running now; a session closed on purpose drops out.
    # A doubled tab makes it a non-whitespace separator, so an empty effort
    # column does not collapse and shift the flags into it.
    [[ -f $SNAP ]] && while IFS=$'\t\t' read -r name cwd id effort flags; do
        persisted "$name" && (( ${open[(Ie)$name]} )) || continue
        native_owned "$name" "$id" && continue
        rows[$name]="$cwd"$'\t'"$id"$'\t'"$effort"$'\t'"$flags"
    done < "$SNAP"
    while IFS=$'\t' read -r name pid pane cwd id ver; do
        persisted "$name" || continue
        rows[$name]="$cwd"$'\t'"$id"$'\t'"$(effort_of "$pid")"$'\t'"$(flags_of "$pid")"
    done < <(claudes)
    mkdir -p "$STATE"
    for name in ${(ko)rows}; do print -r -- "$name"$'\t'"${rows[$name]}"; done > "$SNAP.tmp"
    mv "$SNAP.tmp" "$SNAP"
}

restore() {
    local name cwd id effort flags
    [[ -f $SNAP ]] || return 0
    while IFS=$'\t\t' read -r name cwd id effort flags; do  # \t\t: see save
        persisted "$name" || continue
        native_owned "$name" "$id" && continue
        tmux_ has-session -t "=$name" 2>/dev/null && continue
        [[ -d $cwd ]] || cwd=$HOME
        flags=$(with_peer "$flags")
        # Typed into the pane's shell, so exiting Claude leaves a shell behind.
        tmux_ new-session -d -s "$name" -c "$cwd"
        tmux_ send-keys -t "=$name:" "$LAUNCH $id${effort:+ --effort $effort}${flags:+ $flags}" Enter
        # At login the network and several Claudes start together: wait up to 5 min.
        accept_dev_channels "=$name:" "$flags" ${TMUX_PERSIST_DIALOG_WAIT:-3000} &
        print -r -- "restored $name"
    done < "$SNAP"
    wait
}

# restart_pane <shell> <name> <pid> <pane> <cwd> <id>: same pane, window and
# attached clients; only the pane's process is replaced, by a login <shell>.
# The new Claude gets EFFORT if set, else the old one's launch effort, and the
# old one's KEEP flags; the message goes right after the id, as a flag taking
# several values would swallow it.
restart_pane() {
    local shell=$1 name=$2 pid=$3 pane=$4 cwd=$5 id=$6 tries=0
    local effort=${EFFORT:-$(effort_of "$pid")} flags=$(with_peer "$(flags_of "$pid")")
    [[ -d $cwd ]] || cwd=$HOME
    # An explicit command, since a bare respawn reruns the pane's original one.
    tmux_ respawn-pane -k -t "$pane" -c "$cwd" "exec ${(q)shell} -l"
    # Two Claude processes must not share one transcript.
    while kill -0 "$pid" 2>/dev/null; do
        (( ++tries < 100 )) || { kill -9 "$pid" 2>/dev/null; break; }
        sleep 0.1
    done
    local msg; printf -v msg "$RESTARTED" "$id"
    tmux_ send-keys -t "$pane" "$LAUNCH $id ${(qq)msg}${effort:+ --effort $effort}${flags:+ $flags}" Enter
    accept_dev_channels "$pane" "$flags" ${TMUX_PERSIST_DIALOG_WAIT:-600}
    print -r -- "restarted $name ($pane)"
}

# restart <name>...: every Claude in the named sessions, in parallel. Nothing
# restarts unless each session has one.
restart() {
    local name row pid pane cwd id ver v shell missing=0
    local -a rows found env
    for name in "$@"; do
        found=("${(@f)$(live "$name")}")
        if [[ -z ${found[1]} ]]; then
            print -u2 "tmux-persist: no running Claude in session $name"; missing=1; continue
        fi
        for row in "${found[@]}"; do rows+=("$name"$'\t'"$row"); done
    done
    (( ! missing )) || exit 1
    # Run from inside one of those Claudes (e.g. via `!`), killing its pane would
    # kill us, so the tmux server reruns us outside the pane.
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r name pid pane cwd id ver <<< "$row"
        [[ $pane == "${TMUX_PANE:-}" ]] || continue
        env=(TMUX_PANE=)
        for v in ${(k)parameters[(I)TMUX_PERSIST_*]}; do env+=("$v=${(P)v}"); done
        tmux_ run-shell -b "${(j: :)${(q)env}} ${(q)SELF} restart ${EFFORT:+--effort ${(q)EFFORT}} ${(j: :)${(q)@}}"
        return
    done
    shell=$(tmux_ show -gv default-shell)
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r name pid pane cwd id ver <<< "$row"
        restart_pane "$shell" "$name" "$pid" "$pane" "$cwd" "$id" &
    done
    wait
}

# stale: each session with a Claude older than the installed one, the version
# Claude Code's "Restart to update" refers to.
stale() {
    local name pid pane cwd id ver installed
    installed=${TMUX_PERSIST_VERSION:-$(claude --version)}
    installed=${installed%% *}  # "2.1.310 (Claude Code)"
    claudes | while IFS=$'\t' read -r name pid pane cwd id ver; do
        [[ -n $ver && $ver != "$installed" ]] && print -r -- "$name"
    done | sort -u
}

case ${1:-} in
    save) save ;;
    restore) restore ;;
    stale) stale ;;
    restart) shift
        EFFORT=
        if [[ ${1:-} == --effort ]]; then
            EFFORT=${2:-}; shift $(( $# < 2 ? $# : 2 ))
            [[ -n $EFFORT ]] || set --  # --effort without a level
        fi
        if [[ $* == --all ]]; then
            set -- ${(f)"$(claudes | cut -f1 | sort -u)"}
            (( $# )) || { print -u2 "tmux-persist: no running Claude in any session"; exit 1; }
        elif (( ${@[(Ie)--all]} )); then
            set --  # --all with session names
        fi
        (( $# >= 1 )) || { print -u2 "usage: tmux-persist restart [--effort <level>] <session>...|--all"; exit 2; }
        restart "$@" ;;
    '') [[ -f $SNAP ]] && cat "$SNAP"
        for name in ${(f)"$(tmux_ list-sessions -F '#S' 2>/dev/null || true)"}; do
            persisted "$name" || continue
            [[ -f $SNAP ]] && cut -f1 "$SNAP" | grep -qxF -- "$name" && continue
            print -r -- "$name"$'\t(no snapshot)'
        done ;;
    *) print -u2 "usage: tmux-persist [save|restore|stale|restart [--effort <level>] <session>...|--all]"; exit 2 ;;
esac
