#!/bin/zsh
# Push local conversation titles to their Remote Control sessions after an
# account switch. A conversation started under one account and reconnected
# under another is marked cross-account ("history-suppression" in its
# transcript): Claude Code then names the new remote session with a random
# "<id>-adjective-noun" title and never pushes /rename to it. This script reads
# each marked transcript's latest bridge session and title, and sets that title
# on the remote session through the endpoint Claude Code itself uses
# (PUT /v1/code/sessions/<cse_id>), with the logged-in account's OAuth token.
# Each reconnect of such a conversation also leaves its previous remote session
# active, so the remote list keeps stale copies, often under the same title;
# those are archived (POST /v1/code/sessions/<cse_id>/archive, as Claude Code
# does) unless still connected or some transcript's latest bridge session.
# Only bridge sessions owned by the current account are touched.
# Usage: rc-title   archive superseded sessions, rename live (non-archived)
#                   sessions whose title differs; takes no options
set -euo pipefail

PROJECTS=${RC_TITLE_PROJECTS:-$HOME/.claude/projects}
API=${RC_TITLE_API:-https://api.anthropic.com}

(( $# == 0 )) || { print -u2 "usage: rc-title (takes no options)"; exit 2; }
(( $+commands[rg] )) || { print -u2 "rc-title: ripgrep (rg) not on PATH"; exit 1; }

account=$(jq -r '.oauthAccount.accountUuid // empty' ~/.claude.json)
token=$(security find-generic-password -s 'Claude Code-credentials' -w |
  jq -r '.claudeAiOauth.accessToken // empty')
[[ -n $account && -n $token ]] || { print -u2 "rc-title: not logged in to Claude Code"; exit 1; }

api() {  # api METHOD cse_id [json-body] -> prints body, returns 1 on non-200
  local out code
  out=$(curl -sS -X $1 "$API/v1/code/sessions/$2" \
    -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -H 'anthropic-version: 2023-06-01' ${3:+--data} ${3:+"$3"} -w '\n%{http_code}')
  code=${out##*$'\n'}
  print -r -- "${out%$'\n'*}"
  [[ $code == 200 ]] || { print -u2 "rc-title: $1 $2 -> HTTP $code"; return 1; }
}

tmp=$(mktemp -d)
trap 'rm -rf $tmp' EXIT

# GET the sessions in parallel into $tmp/<id>; a failed one leaves no file.
fetch_sessions() {
  local id code file
  for id in $@; do print -r -- "url = \"$API/v1/code/sessions/$id\""$'\n'"output = \"$tmp/$id\""; done >$tmp/curl.cfg
  curl -sS --parallel --parallel-max 8 --config $tmp/curl.cfg -w '%{http_code} %{filename_effective}\n' \
    -H "Authorization: Bearer $token" -H 'anthropic-version: 2023-06-01' |
    while read -r code file; do
      [[ $code == 200 ]] && continue
      print -u2 "rc-title: GET ${file:t} -> HTTP $code"
      rm -f -- $file
    done || true
}

session() { [[ -f $tmp/$1 ]] && jq -c '.session // .response_shape // .' $tmp/$1; }

# Transcripts total gigabytes and only a few match, so scan them with rg.
scan() { rg --no-config --no-ignore --hidden --no-filename -N "$@"; }

# Every transcript's latest bridge session: a resumed or forked conversation may
# still be on one that an older transcript shows as superseded.
typeset -A latest
for f in ${(f)"$(scan -l -g '*.jsonl' '^\{"type":"bridge-session"' "$PROJECTS" || true)"}; do
  cse=$(scan '^\{"type":"bridge-session"' "$f" | jq -rs 'map(.bridgeSessionId | select(. != "")) | last // empty')
  [[ -z $cse ]] || latest[$cse]=1
done

changed=0 retired=0
typeset -A seen
files=(${(f)"$(scan -l -g '*.jsonl' '^\{"type":"history-suppression"' "$PROJECTS" || true)"})
# Newest first: a resumed or forked conversation shares the bridge session of
# the one it came from, and the transcript touched last holds the live title.
metas=() ids=()
for f in ${(f)"$( (( $#files )) && ls -t -- $files )"}; do
  # Latest bridge session and title; a custom title wins over the AI title.
  meta=$(scan '^\{"type":"(bridge-session|custom-title|ai-title)"' "$f" | jq -sc --arg a "$account" '
    map(select(.type == "bridge-session")) as $b | {
    bridge: ($b | last),
    old: ($b | map(select(.ownerAccountUuid == $a) | .bridgeSessionId) | unique - [$b[-1].bridgeSessionId]),
    title: ((map(select(.type == "custom-title")) | last | .customTitle)
            // (map(select(.type == "ai-title")) | last | .aiTitle))}')
  metas+=$meta
  for old in ${(f)"$(jq -r '.old[]' <<<$meta)"}; do
    [[ -n ${latest[$old]:-} ]] || ids+=$old
  done
  ids+=(${(f)"$(jq -r --arg a "$account" 'select(.title and .bridge.ownerAccountUuid == $a) | .bridge.bridgeSessionId // empty' <<<$meta)"})
done
(( $#ids )) && fetch_sessions ${(u)ids}

for meta in "${metas[@]}"; do
  cse=$(jq -r '.bridge.bridgeSessionId // empty' <<<$meta)
  owner=$(jq -r '.bridge.ownerAccountUuid // empty' <<<$meta)
  title=$(jq -r '.title // empty' <<<$meta)

  for old in ${(f)"$(jq -r '.old[]' <<<$meta)"}; do
    [[ -z ${latest[$old]:-} && -z ${seen[$old]:-} ]] || continue
    seen[$old]=1
    remote=$(session $old) || continue
    jq -e '.status != "archived" and .connection_status != "connected"' <<<$remote >/dev/null || continue
    print -r -- "$old: archive superseded $(jq -r '.title // "<none>"' <<<$remote)"
    api POST $old/archive '{}' >/dev/null && (( ++retired ))
  done

  [[ -n $cse && -n $title && $owner == "$account" && -z ${seen[$cse]:-} ]] || continue
  seen[$cse]=1

  remote=$(session $cse) || continue
  state=$(jq -r '.status // empty' <<<$remote)
  current=$(jq -r '.title // empty' <<<$remote)
  [[ $current == "$title" ]] && continue
  [[ $state != archived ]] || continue

  print -r -- "$cse ($state): ${current:-<none>} -> $title"
  api PUT $cse "$(jq -nc --arg t "$title" '{title: $t}')" >/dev/null && (( ++changed ))
done
print "rc-title: renamed $changed, archived $retired session(s)"
