            "/clear 或重启后它会再提醒你。不需要用户决定、但用户该马上知道的事（坏消息、长任务跑完、需要他回电脑看）"
            "用 `agent-ask notify \"一两句白话\"` 推到他飞书；例行进度不要推，上限 {limit} 字。")


def agy_session(raw):
    event = json.loads(raw)
    for old in agy_records():  # exited sessions: their token is dead weight
        if not alive(old.get("pid")):
            try:
                os.remove(os.path.join(AGY_DIR, f"{old.get('sessionId')}.json"))
            except OSError:
                pass  # another session's start removed it first
    record = agy_current(event.get("conversationId"))
    if not record:
        print("{}")
        return
    hint = AGY_HINT.format(limit=MAX_NOTIFY)
    if record.get("csrf"):
        hint = hint.replace(AGY_REGISTER, "")
    print(json.dumps({"injectSteps": [{"systemMessage": {"systemMessage": hint}}]}, ensure_ascii=False))


def agy_register(quiet=False):
    """Run by the agent: record how the hub reaches this conversation. Returns the record, or None."""
    record = agy_current(os.environ.get("ANTIGRAVITY_CONVERSATION_ID"))
    if not record:
        quiet or print("没有登记：只有 tmux 会话名以 -r2v 结尾的 tmux 会话里运行的 agy 能接飞书")
        return None
    record.update(ls=os.environ.get("ANTIGRAVITY_LS_ADDRESS"), csrf=os.environ.get("ANTIGRAVITY_CSRF_TOKEN"),
                  exe=os.environ.get("ANTIGRAVITY_AGENTAPI_EXE") or "agy")
    if not (record["ls"] and record["csrf"]):
        quiet or print("没有登记：环境里没有 ANTIGRAVITY_LS_ADDRESS / ANTIGRAVITY_CSRF_TOKEN（要由 agy 里的 agent 自己运行）")
        return None
    agy_save(record)
    quiet or print(f"已登记：{record['name']} 的飞书答复会直接送进这个对话")
    return record


AGY_PUSHING = {}  # sid -> lock: the click, message and retry threads must not push the same answer twice
AGY_PUSHING_LOCK = threading.Lock()


def deliver_agy(sid):
    """Push the agy conversation's undelivered answers and thread messages into it, then mark exactly those
    delivered. Called by the hub after each click and message, and every minute for what a failed push left."""
    with AGY_PUSHING_LOCK:
        lock = AGY_PUSHING.setdefault(sid, threading.Lock())
    with lock:
        push_agy(sid)


def push_agy(sid):
    record = agy_load(sid)
    if not record or not record.get("csrf") or not alive(record["pid"]):
        return
    answers = [r for r in records() if r["sid"] == sid and r["status"] == "answered"]
    items = [i for i in inbox_items() if i["sid"] == sid and i["status"] == "pending"]
    if not answers and not items:
        return
    text = "\n\n".join([answer_text(r) for r in answers] + [message_answer_text(i) for i in items])
    env = {**os.environ, "ANTIGRAVITY_LS_ADDRESS": record["ls"], "ANTIGRAVITY_CSRF_TOKEN": record["csrf"],
           "NO_PROXY": "localhost,127.0.0.1,::1", "no_proxy": "localhost,127.0.0.1,::1"}
    # The delivery time is taken before the push: agy may reply within the call, and stamps whole seconds.
    at = now()
    try:
        out = subprocess.run([record.get("exe") or "agy", "agentapi", "send-message", sid, text],
                             capture_output=True, text=True, env=env, timeout=30)
        sent = out.returncode == 0 and "sendMessage" in out.stdout
    except (OSError, subprocess.SubprocessError) as error:
        out, sent = error, False
    if not sent:
        detail = f"{out.stdout} {out.stderr}" if isinstance(out, subprocess.CompletedProcess) else str(out)
        log(f"agy push to {record['name']} failed: {detail.strip()[:300]}")
        return
    for r in answers:
        take_answer(r["qid"], at)
    take_messages(sid, ids={i["message_id"] for i in items}, at=at)
    log(f"agy push to {record['name']}: {len(answers)} answers, {len(items)} messages")


def short(name):
    return name[: -len(SCOPE_SUFFIX)].strip()


def addressed(text, names):
    """The session a private-chat message names at its start ("training 看下…", "@Compare：…") and the rest.
    A name is the session's name without "(R2V)", with or without spaces, or its last word when no other
    session shares it ("compare"); case does not matter."""
    keys, lasts = {}, {}
    for name in names:
        lasts.setdefault(short(name).lower().split()[-1], []).append(name)
    keys.update({last: found[0] for last, found in lasts.items() if len(found) == 1})
    for name in names:
        keys[short(name).lower()] = keys[short(name).lower().replace(" ", "")] = name
    head = text.lstrip().lstrip("@").lstrip()
    for key in sorted(keys, key=len, reverse=True):
        if head.lower().startswith(key) and not head[len(key):len(key) + 1].isalnum():
            return keys[key], head[len(key):].lstrip(" :：,，、").strip()
    return None, text


def in_scope(sid):
    name = session_name(sid)
    return bool(os.environ.get("TMUX")) and bool(name) and name.endswith(SCOPE_SUFFIX), name


def qid_for(event):
    key = f"{event.get('session_id')}:{event.get('tool_use_id') or json.dumps(event.get('tool_input'), sort_keys=True)}"
    return hashlib.sha1(key.encode()).hexdigest()[:8]


# ---- Feishu ---------------------------------------------------------------------------

def lark(args, stdin=None):
    cfg = config()
    result = subprocess.run([LARK, "--profile", cfg["profile"], *args, "--as", "bot"], input=stdin,
                            capture_output=True, text=True, timeout=60)
    try:
        body = json.loads(result.stdout)
    except ValueError:
        body = {}
    if not body.get("ok"):
        raise RuntimeError(f"lark-cli {args[:3]} failed: {result.stdout[-400:]} {result.stderr[-400:]}")
    return body.get("data") or {}


def send_card(card):
    data = lark(["im", "+messages-send", "--chat-id", config()["chat_id"], "--msg-type", "interactive",
                 "--content", "-"], stdin=json.dumps(card, ensure_ascii=False))
    return data["message_id"]


def patch_card(message_id, card):
    lark(["im", "messages", "patch", "--message-id", message_id,
          "--data", json.dumps({"content": json.dumps(card, ensure_ascii=False)}, ensure_ascii=False)])


def md(text):
    return {"tag": "markdown", "content": text}


def grey(text):
    return md(f"<font color='grey'>{text}</font>")


def note(text):
    return {"tag": "markdown", "content": f"<font color='grey'>{text}</font>", "text_size": "notation"}


def submit(name, label, value, kind="default"):
    return {"tag": "button", "name": name, "form_action_type": "submit", "type": kind,
            "text": {"tag": "plain_text", "content": label}, "behaviors": [{"type": "callback", "value": value}]}


# Claude writes the mark after the label; agy's ask_question asks for it in front ("(Recommended) 米饭").
RECOMMENDED = re.compile(r"^\s*[（(](?:推荐|Recommended)[）)]\s*|\s*[（(](?:推荐|Recommended)[）)]\s*$")


def option_row(name, option, value):
    """Label and description read together on the left, one button on the right: a full-width button
    with its description below left the description looking like it belonged to the next button."""
    label = option["label"]
    recommended = bool(RECOMMENDED.search(label))
    text = f"**{RECOMMENDED.sub('', label)}**" + ("　<font color='blue'>推荐</font>" if recommended else "")
    if option.get("description"):
        text += f"\n<font color='grey'>{option['description']}</font>"
    return {"tag": "column_set", "flex_mode": "none", "horizontal_spacing": "12px", "margin": "8px 0 0 0", "columns": [
        {"tag": "column", "width": "weighted", "weight": 1, "vertical_align": "center", "elements": [md(text)]},
        {"tag": "column", "width": "auto", "vertical_align": "center", "elements": [
            submit(name, "选这个", value, "primary_filled" if recommended else "default")]}]}


def question_block(record, i, last):
    """Each question is one form. Single choice: one row per option (label and description, 「选这个」 on
    the right); clicking it submits the option together with whatever is in the text box. Multiple
    choice: checkboxes plus 「提交所选」. The text box alone answers with free text; on the last question
    「没看懂」 closes the whole card."""
    q = record["questions"][i]
    multi = bool(q.get("multiSelect"))
    head = f"**{i + 1}. {q['question']}**" if len(record["questions"]) > 1 else f"**{q['question']}**"
    elements = [md(head)]
    answer = record["answers"].get(str(i))
    if answer is not None:
        return elements + [md(f"✅ **{answer}**")]
    value = {"qid": record["qid"], "i": i}
    form = [note("可多选，勾好后点「提交所选」")] if multi else []
    for j, o in enumerate(q.get("options", [])):
        desc = o.get("description", "")
        if multi:
            form.append({"tag": "checker", "name": f"c{j}", "checked": False, "text": {"tag": "lark_md", "content":
                         o["label"] + (f"　<font color='grey'>{desc}</font>" if desc else "")}})
        else:
            form.append(option_row(f"o{i}_{j}", o, {**value, "pick": o["label"]}))
        if o.get("preview"):
            form.append({"tag": "collapsible_panel", "expanded": False,
                         "header": {"title": {"tag": "plain_text", "content": f"预览：{o['label']}"}},
                         "elements": [md(f"```\n{o['preview'][:1500]}\n```")]})
    if not multi:
        form += [{"tag": "hr", "margin": "12px 0 0 0"}, note("都不合适就写下你的回答点「提交文字」；也可以先写补充再点上面的选项")]
    hint = "补充说明" if multi else "你的回答或补充"
    buttons = [submit(f"s{i}", "提交所选" if multi else "提交文字", {**value, "pick": "__form__"})]
    if last:
        buttons.append(submit("su", "🤔 没看懂", {"qid": record["qid"], "i": -1, "pick": "__unclear__"}))
    form.append({"tag": "column_set", "columns": [
        {"tag": "column", "width": "weighted", "weight": 1, "vertical_align": "center", "elements": [
            {"tag": "input", "name": f"t{i}", "placeholder": {"tag": "plain_text", "content": hint}}]},
        *({"tag": "column", "width": "auto", "vertical_align": "center", "elements": [b]} for b in buttons)]})
    return elements + [{"tag": "form", "name": f"f{i}", "elements": form}]


def render(record):
    status = record["status"]
    if record.get("unclear") is not None:
        return render_unclear(record)
    title, color = {"pending": (f"❓ {record['session']} 在问", "blue"),
                    "answered": (f"✅ 已答 · {record['session']}", "green"),
                    "delivered": (f"✅ 已答 · {record['session']}", "green"),
                    "withdrawn": (f"已撤回 · {record['session']}", "grey")}[status]
    elements = summary_block(record) if status == "pending" else []
    n = len(record["questions"])
    for i in range(n):
        elements += question_block(record, i, i == n - 1) if status != "withdrawn" else [md(record["questions"][i]["question"])]
        elements.append({"tag": "hr"})
    footer = [f"{hhmm(record['asked_at'])[6:]} 提问"]
    if status == "pending" and any(not q.get("multiSelect") and str(i) not in record["answers"]
                                   for i, q in enumerate(record["questions"])):
        footer.insert(0, "点选项即提交")
    if status == "delivered":
        footer.append(f"{hhmm(record['delivered_at'])[6:]} 已送达")
    elif status == "answered" and now() - record["answered_at"] > UNDELIVERED_AFTER:
        footer.append("⚠️ 还没送达：会话可能已退出或卡住")
    elif status == "answered":
        footer.append("等会话收下")
    elif status == "withdrawn":
        footer.append(f"会话已撤回：{record.get('withdraw_reason') or '不再需要'}")
    elements.append(grey(" · ".join(footer)))
    return {"schema": "2.0", "config": {"update_multi": True},
            "header": {"title": {"tag": "plain_text", "content": title}, "template": color},
            "body": {"elements": elements}}


def render_unclear(record):
    elements = [md("\n".join(f"- {q['question']}" for q in record["questions"]))]
    if record["unclear"]:
        elements.append(md(f"🤔 **你的反馈：{record['unclear']}**"))
    footer = [f"{hhmm(record['asked_at'])[6:]} 提问"]
    footer.append(f"{hhmm(record['delivered_at'])[6:]} 已送达，会话会换个说法重问" if record["status"] == "delivered"
                  else "等会话收下后重问")
    elements.append(grey(" · ".join(footer)))
    return {"schema": "2.0", "config": {"update_multi": True},
            "header": {"title": {"tag": "plain_text", "content": f"🤔 没看懂 · {record['session']}"}, "template": "orange"},
            "body": {"elements": elements}}


def too_long(questions, label_limit=MAX_LABEL):
    """What to shorten, or [] when every part fits. agy options carry their explanation in the label."""
    problems = []
    for n, q in enumerate(questions, 1):
        if len(q.get("question", "")) > MAX_QUESTION:
            problems.append(f"第 {n} 题题干 {len(q['question'])} 字（上限 {MAX_QUESTION}）")
        for o in q.get("options", []):
            if len(o.get("label", "")) > label_limit:
                problems.append(f"第 {n} 题选项「{o['label'][:12]}…」标签 {len(o['label'])} 字（上限 {label_limit}）")
            if len(o.get("description", "")) > MAX_DESCRIPTION:
                problems.append(f"第 {n} 题选项「{o['label'][:12]}」说明 {len(o['description'])} 字（上限 {MAX_DESCRIPTION}）")
    return problems


def pending_records():
    return [r for r in records() if r["status"] == "pending"]


def summary_block(record):
    """The newest pending card lists the others, so the user needs no separate summary message."""
    pending = pending_records()
    if len(pending) < 2 or pending[-1]["qid"] != record["qid"]:
        return []
    lines = [f"• **{r['session']}**　{r['questions'][0]['question'][:40]}　<font color='grey'>{hhmm(r['asked_at'])[6:]}</font>"
             for r in pending[:-1]]
    return [md(f"📋 **还有 {len(pending) - 1} 条没答**（往上翻）\n" + "\n".join(lines)), {"tag": "hr"}]


def refresh_summary():
    """Move the list of other open questions onto the newest pending card."""
    pending = pending_records()
    holder = pending[-1]["qid"] if len(pending) > 1 else None
    try:
        old = json.load(open(SUMMARY)).get("holder")
    except (OSError, ValueError):
        old = None
    for qid in {old, holder} - {None}:
        record = load(qid)
        if record:
            try:
                patch_card(record["message_id"], render(record))
            except RuntimeError as error:
                log(f"summary patch failed {qid}: {error}")
    json.dump({"holder": holder}, open(SUMMARY, "w"))


def log(text):
    os.makedirs(ROOT, exist_ok=True)
    with open(LOG, "a") as handle:
        handle.write(f"{time.strftime('%F %T')} {text}\n")


# ---- answers --------------------------------------------------------------------------

def answer_text(record):
    if record.get("unclear") is not None:
        feedback = f"，反馈：{record['unclear']}" if record["unclear"] else ""
        return (f"[飞书回答] 用户本人没看懂你 {hhmm(record['asked_at'])} 的提问（待答 {record['qid']}）{feedback}。"
                f"补上背景、编号和缩写换成白话，重新调用 {TOOL[record.get('host', 'claude')]} 问一次；答复前照旧按默认推进。")
    lines = [f"[飞书回答] 用户本人回答了你 {hhmm(record['asked_at'])} 的提问（待答 {record['qid']}）："]
    for i, q in enumerate(record["questions"]):
        lines.append(f"- {q['question']} → {record['answers'].get(str(i))}")
    lines.append("照此继续，已按默认做的部分按回答改正。")
    return "\n".join(lines)


def typed(record):
    """Whether the user wrote anything rather than only clicking options: such answers often ask back."""
    labels = {o["label"] for q in record["questions"] for o in q.get("options", [])}
    return any("（补充：" in a or not set(a.split(", ")) <= labels for a in record["answers"].values())


def take_answer(qid, at=None):
    """answered -> delivered exactly once across the waiter and the per-tool hook; `at` is when it was sent."""
    with locked():
        record = load(qid)
        if not record or record["status"] != "answered":
            return None
        record["status"], record["delivered_at"] = "delivered", at or now()
        record["reply_pending"] = typed(record)
        save(record)
    try:
        patch_card(record["message_id"], render(record))
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"delivered patch failed {qid}: {error}")
    return record


# ---- thread replies -------------------------------------------------------------------

def remember_thread(message_id, sid, session, label):
    """Record which session a bot message belongs to, so a reply under it finds its way back."""
    os.makedirs(THREADS, exist_ok=True)
    tmp = os.path.join(THREADS, f".{message_id}.{os.getpid()}.tmp")
    json.dump({"sid": sid, "session": session, "label": label}, open(tmp, "w"), ensure_ascii=False)
    os.replace(tmp, os.path.join(THREADS, f"{message_id}.json"))


def thread_owner(message_ids):
    for mid in filter(None, message_ids):
        try:
            return json.load(open(os.path.join(THREADS, f"{mid}.json")))
        except (OSError, ValueError):
            pass
        for record in records():
            if record.get("message_id") == mid:
                return {"sid": record["sid"], "session": record["session"],
                        "label": f"你 {hhmm(record['asked_at'])} 的提问（待答 {record['qid']}）"}
    return None


def message_text(message_type, content):
    try:
        body = json.loads(content or "{}")
    except ValueError:
        body = {}
    if message_type == "text":
        return re.sub(r"@_user_\d+\s*", "", body.get("text") or "").strip()  # @-mentions of the bot in a group
    if message_type == "post":
        if body and "content" not in body:
            body = next(iter(body.values()))  # the send API wraps a post in its locale; events do not
        lines = ["".join(seg.get("text", "") for seg in row if isinstance(seg, dict)) for row in body.get("content") or []]
        return "\n".join(filter(None, [body.get("title") or "", *lines])).strip()
    return f"[{message_type} 消息，文字以外的内容请到飞书看]"


def inbox_items():
    out = []
    for path in glob.glob(os.path.join(INBOX, "*.json")):
        try:
            out.append(json.load(open(path)))
        except (OSError, ValueError):
            continue
    return sorted(out, key=lambda r: r["at"])


def save_item(item):
    os.makedirs(INBOX, exist_ok=True)
    path = os.path.join(INBOX, f"{item['message_id']}.json")
    tmp = f"{path}.{os.getpid()}.tmp"
    json.dump(item, open(tmp, "w"), ensure_ascii=False, indent=1)
    os.replace(tmp, path)
    marker = os.path.join(ANSWERED, f"msg-{item['message_id']}")
    if item["status"] == "pending" and item.get("host") != "agy":
        os.makedirs(ANSWERED, exist_ok=True)
        open(marker, "a").close()
    elif os.path.exists(marker):
        os.remove(marker)


def on_message(sender, message):
    """File one message the user typed for the session it is meant for: the owner of the thread it is in,
    the session whose group it is in, or the session named at its start in the private chat.
    Returns what happened, for the log."""
    cfg = config()
    if sender != cfg["user_open_id"]:
        return f"ignored message from {sender}"
    chat, groups = message.get("chat_id"), cfg.get("groups") or {}
    if chat != cfg["chat_id"] and chat not in groups:
        return f"ignored message in {chat}"
    mid = message["message_id"]
    text = message_text(message.get("message_type"), message.get("content"))
    live = live_sessions()
    owner = None if chat in groups else thread_owner([message.get("root_id"), message.get("parent_id")])
    if chat in groups:  # quoting an earlier reply in the group still means this session
        owner, where, thread = {"session": groups[chat]}, "在你们俩的飞书群里给你发了消息", False
    elif owner:
        where, thread = f"在{owner['label']}下面回复了你", True
    else:
        name, rest = addressed(text, live)
        if not name:
            say(mid, "这条没有发给任何会话：开头写会话名，比如「training 看下…」，或在它的群里说。"
                     f"在线的有：{'、'.join(short(n) for n in live) or '（没有）'}")
            return f"message {mid} names no session"
        owner, text, where, thread = {"session": name}, rest or text, "在飞书私聊里点名发给你", True
    sid = live.get(owner["session"]) or owner.get("sid")  # the thread may predate a restart
    if not sid or owner["session"] not in live:
        say(mid, f"{owner['session']} 现在没在运行，这条没送到。")
        return f"message {mid} for {owner['session']}, which is not running"
    if not text:
        return f"message {mid} is empty"
    if len(text) > MAX_INBOUND:
        text = text[:MAX_INBOUND] + "…（后面截断了，全文在飞书）"
    with locked():
        if os.path.exists(os.path.join(INBOX, f"{mid}.json")):
            return f"message {mid} already filed"  # Feishu redelivers an event it thinks failed
        save_item({"message_id": mid, "sid": sid, "session": owner["session"], "where": where, "thread": thread,
                   "text": text, "at": now(), "status": "pending", **({"host": "agy"} if agy_load(sid) else {})})
    return f"message {mid} for {owner['session']} {len(text)} chars"


def say(message_id, text):
    """Answer the user's message from the hub itself (not from a session)."""
    try:
        lark(["im", "+messages-reply", "--message-id", message_id, "--text", text])
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"say failed {message_id}: {error}")


def message_answer_text(item):
    where = item.get("where") or f"在{item['label']}下面回复了你"
    back = "这个话题" if item.get("thread", True) else "那个群"
    return (f"[飞书消息] 用户本人{where}（{hhmm(item['at'])}）：\n\n{item['text']}\n\n"
            f"照此继续；你接下来的回复会自动发回{back}。")


def take_messages(sid, listener=None, ids=None, at=None):
    """pending -> delivered exactly once across hook-deliver and hook-listen; a listener takes nothing once
    a newer one has replaced it. `ids` limits it to the messages a push actually carried."""
    taken = []
    with locked():
        if listener and listening(sid) != listener:
            return []
        for item in inbox_items():
            if item["sid"] == sid and item["status"] == "pending" and (ids is None or item["message_id"] in ids):
                item["status"], item["delivered_at"], item["reply_pending"] = "delivered", at or now(), True
                save_item(item)
                taken.append(item)
    for item in taken:
        try:
            lark(["im", "reactions", "create", "--params", json.dumps({"message_id": item["message_id"]}),
                  "--data", json.dumps({"reaction_type": {"emoji_type": "DONE"}})])
        except (RuntimeError, OSError, subprocess.SubprocessError) as error:
            log(f"receipt failed {item['message_id']}: {error}")
        log(f"message {item['message_id']} delivered to {item['session']}")
    return [message_answer_text(item) for item in taken]


# ---- hooks ----------------------------------------------------------------------------

def file_question(sid, name, cwd, qid, questions, host="claude"):
    """Send the card for one question call. Returns the reason to deny the terminal dialog with, or None to let
    the dialog run (the card could not be sent)."""
    problems = too_long(questions, MAX_LABEL + MAX_DESCRIPTION if host == "agy" else MAX_LABEL)
    if problems:
        return ("问题没有发出，用户在手机上读，要短而自包含：" + "；".join(problems)
                + f"。只留要定什么和各选项的后果，缺的背景用一句白话补上，再调用 {TOOL[host]}。")
    record = {"qid": qid, "sid": sid, "session": name, "project": os.path.basename(cwd or ""), "host": host,
              "questions": questions, "answers": {}, "status": "pending", "asked_at": now()}
    try:
        record["message_id"] = send_card(render(record))
    except (RuntimeError, OSError, subprocess.SubprocessError, KeyError, ValueError) as error:
        log(f"send failed {qid}: {error}")
        return None  # fall back to the terminal dialog rather than losing the question
    with locked():
        save(record)
    try:
        refresh_summary()
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"summary failed: {error}")
    if host == "agy":
        how = ("答复会作为一条新消息送进这个对话，空闲时也会唤醒你；" if (agy_load(sid) or {}).get("csrf") else
               "先运行一次 `agent-ask agy-register`（每个会话一次），否则答复送不回来；答复会作为一条新消息送进这个对话；")
    else:
        how = "答复会以 hook 消息送来，空闲时也会唤醒你；"
    lead = "发送成功：agy 会把这条回执显示成 tool call denied，但问题已经发出。" if host == "agy" else ""
    return (f"{lead}✅ 已发到用户飞书（待答 {qid}）。这是回执，不是故障：不要重问，也别停下等，先照推荐项继续，"
            f"只把不可逆或对外的那步留到答复后。{how}问题过时了就 `agent-ask withdraw {qid} 原因`。")


def hook_ask(raw):
    event = json.loads(raw)
    sid = event.get("session_id") or "?"
    scoped, name = in_scope(sid)
    if not scoped:
        return
    reason = file_question(sid, name, event.get("cwd"), qid_for(event), event.get("tool_input", {}).get("questions", []))
    if reason:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                 "permissionDecisionReason": reason}}, ensure_ascii=False))


def agy_ask(raw):
    """ask_question takes plain-string options; the card's option rows take label/description pairs."""
    event = json.loads(raw)
    conv, call = event.get("conversationId"), event.get("toolCall") or {}
    record = agy_current(conv)
    reason = None
    if record:
        questions = [{"question": q.get("question", ""), "multiSelect": bool(q.get("is_multi_select")),
                      "options": [{"label": o} if isinstance(o, str) else o for o in q.get("options", [])]}
                     for q in (call.get("args") or {}).get("questions", [])]
        key = call.get("id") or json.dumps(call.get("args"), sort_keys=True)
        qid = hashlib.sha1(f"{conv}:{key}".encode()).hexdigest()[:8]
        reason = file_question(conv, record["name"], event.get("cwd"), qid, questions, host="agy")
    print(json.dumps({"decision": "deny", "reason": reason} if reason else {"decision": "allow"}, ensure_ascii=False))


def hook_wait(raw):
    event = json.loads(raw)
    if not in_scope(event.get("session_id") or "?")[0]:
        return 0
    qid, start = qid_for(event), now()
    while now() - start < WAIT_LIMIT:
        record = load(qid)
        if record is None and now() - start > 120:
            return 0  # the card never went out; the terminal dialog handled it
        if record and record["status"] in ("delivered", "withdrawn"):
            return 0
        if record and record["status"] == "answered":
            taken = take_answer(qid)
            if taken:
                sys.stderr.write(answer_text(taken) + "\n")
                return 2
        time.sleep(WAIT_SLICE)
    return 0


NOTIFY_HINT = ("你的提问（AskUserQuestion）会发到用户飞书。不需要用户决定、但用户该马上知道的事"
               "（坏消息、长任务跑完、需要他回电脑看）用 `agent-ask notify \"一两句白话\"` 推到他飞书；"
               f"例行进度不要推，上限 {MAX_NOTIFY} 字。")


def hook_session(raw):
    if in_scope(json.loads(raw).get("session_id") or "?")[0]:
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": NOTIFY_HINT}},
                         ensure_ascii=False))


def hook_deliver(raw):
    event = json.loads(raw)
    sid = event.get("session_id")
    if not sid or not os.path.isdir(QDIR):
        return
    texts = []
    for record in records():
        if record["sid"] == sid and record["status"] == "answered":
            taken = take_answer(record["qid"])
            if taken:
                texts.append(answer_text(taken))
    texts += take_messages(sid)
    if texts:
        name = event.get("hook_event_name") or "PostToolUse"
        print(json.dumps({"hookSpecificOutput": {"hookEventName": name, "additionalContext": "\n\n".join(texts)}},
                         ensure_ascii=False))


def last_reply(transcript, since):
    """The session's last text message written after `since` (epoch seconds), or None."""
    text = None
    try:
        lines = open(transcript, encoding="utf-8")
    except (OSError, TypeError):
        return None
    with lines:
        for line in lines:
            if '"assistant"' not in line:
                continue
            try:
                entry = json.loads(line)
                ts = entry["timestamp"].replace("Z", "+00:00")
                when = datetime.datetime.fromisoformat(ts).timestamp()
            except (ValueError, KeyError, AttributeError):
                continue
            if entry.get("type") != "assistant" or when < since:
                continue
            parts = [c.get("text", "") for c in entry.get("message", {}).get("content", [])
                     if isinstance(c, dict) and c.get("type") == "text"]
            if "".join(parts).strip():
                text = "\n".join(parts).strip()
    return text


def agy_last_reply(transcript, since):
    """The agent's last text reply in an agy transcript_full.jsonl written after `since`, or None."""
    text = None
    try:
        lines = open(transcript, encoding="utf-8")
    except (OSError, TypeError):
        return None
    with lines:
        for line in lines:
            if '"PLANNER_RESPONSE"' not in line:
                continue
            try:
                entry = json.loads(line)
                when = datetime.datetime.fromisoformat(entry["created_at"].replace("Z", "+00:00")).timestamp()
            except (ValueError, KeyError, AttributeError):
                continue
            # agy stamps whole seconds; the delivery time is a float taken before the push
            if entry.get("type") == "PLANNER_RESPONSE" and when >= int(since) and (entry.get("content") or "").strip():
                text = entry["content"].strip()
    return text


def hook_reply(raw):
    event = json.loads(raw)
    post_replies(event.get("session_id"), event.get("transcript_path"), last_reply)


def agy_reply(raw):
    event = json.loads(raw)
    # The hook names transcript.jsonl, which shortens long steps; transcript_full.jsonl beside it keeps them.
    transcript = event.get("transcriptPath")
    if transcript and os.path.isfile(full := os.path.join(os.path.dirname(transcript), "transcript_full.jsonl")):
        transcript = full
    post_replies(event.get("conversationId"), transcript, agy_last_reply)
    print("{}")


def post_replies(sid, transcript, last_reply):
    """Post the session's reply under each card or thread message it was handed that is waiting for one."""
    if not sid or not (os.path.isdir(QDIR) or os.path.isdir(INBOX)):  # a thread message alone makes only INBOX
        return
    for record in records():
        if record["sid"] != sid or not record.get("reply_pending"):
            continue
        text = last_reply(transcript, record["delivered_at"])
        if not text:
            continue
        with locked():
            current = load(record["qid"])
            if not current or not current.get("reply_pending"):
                continue
            current["reply_pending"] = False
            save(current)
        post_reply(current["message_id"], sid, current["session"], text, current["qid"])
    waiting = [item for item in inbox_items() if item["sid"] == sid and item.get("reply_pending")]
    text = waiting and last_reply(transcript, min(item["delivered_at"] for item in waiting))
    if not text:
        return
    with locked():  # one reply answers every message delivered with it: post it once, under the newest
        current = [item for item in inbox_items() if item["sid"] == sid and item.get("reply_pending")]
        for item in current:
            item["reply_pending"] = False
            save_item(item)
    if current:
        newest = current[-1]
        post_reply(newest["message_id"], sid, newest["session"], text, newest["message_id"], newest.get("thread", True))


def post_reply(message_id, sid, session, text, ref, thread=True):
    """Post the session's reply in the thread of `message_id` (in a session's own group, as a plain reply to
    it), and remember it so a reply under it comes back."""
    if len(text) > MAX_REPLY:
        text = text[:MAX_REPLY] + "\n\n…（后面还有，全文在终端）"
    try:
        data = lark(["im", "+messages-reply", "--message-id", message_id, *(["--reply-in-thread"] if thread else []),
                     "--markdown", "-"], stdin=f"💬 **{session}** 回复：\n\n{text}" if thread else text)
        log(f"reply {ref} posted {len(text)} chars")
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        log(f"reply failed {ref}: {error}")
        return
    if data.get("message_id"):
        remember_thread(data["message_id"], sid, session, "你贴在话题里的回复")


def listening(sid):
    try:
        return open(os.path.join(LISTENERS, f"{sid}.pid")).read().strip()
    except OSError:
        return None


def hook_listen(raw):
    """Wait in the background while the session is idle; wake it (exit 2) with the user's thread replies.
    The listener of the session's latest Stop waits and earlier ones leave: on 11-19 a listener left over
    from an earlier turn took messages for idle Compare and Data and exited 2, and neither session woke."""
    event = json.loads(raw)
    sid = event.get("session_id") or "?"
    if not in_scope(sid)[0]:
        return 0
    os.makedirs(LISTENERS, exist_ok=True)
    me = str(os.getpid())
    with locked():
        with open(os.path.join(LISTENERS, f"{sid}.pid"), "w") as f:
            f.write(me)
    parent, start = os.getppid(), now()
    while now() - start < WAIT_LIMIT:
        if listening(sid) != me:
            return 0  # a later Stop started its own listener
        if glob.glob(os.path.join(ANSWERED, "msg-*")):
            texts = take_messages(sid, me)
            if texts:
                sys.stderr.write("\n\n".join(texts) + "\n")
                log(f"listener {me} woke {sid[:8]}")
                return 2
        try:
            os.kill(parent, 0)
        except OSError:
            return 0  # the session is gone
        time.sleep(LISTEN_SLICE)
    return 0


# ---- hub ------------------------------------------------------------------------------

def on_action(operator, value, form):
    """Record one click and return the card it should turn into, or None to leave the card as is.
    The hub hands the card back in the callback response, so Feishu redraws it the moment the click returns."""
    if operator != config()["user_open_id"]:
        log(f"ignored click from {operator}")
        return None
    value, form = value or {}, form or {}
    qid, i = value.get("qid"), value.get("i")
    if not qid or i is None or not os.path.exists(qpath(qid)):
        log(f"click for unknown question: {value} form={form}")
        return None
    with locked():
        record = load(qid)
        if not record or record["status"] != "pending":
            return None
        if value.get("pick") == "__unclear__":
            record["unclear"] = next((v.strip() for v in form.values() if isinstance(v, str) and v.strip()), "")
            answer = None
        else:
            if str(i) in record["answers"]:
                return None
            answer = answer_for(record["questions"][i], value.get("pick"), form, i)
            if answer is None:
                return None
            record["answers"][str(i)] = answer
        if answer is None or len(record["answers"]) == len(record["questions"]):
            record["status"], record["answered_at"] = "answered", now()
        save(record)
    log(f"unclear {qid}: {record['unclear']}" if answer is None else f"answer {qid}[{i}] = {answer}")
    if record["status"] == "answered":
        threading.Thread(target=refresh_summary).start()  # other cards; must not delay the response
        if record.get("host") == "agy":
            threading.Thread(target=deliver_agy, args=(record["sid"],)).start()
    return render(record)


def answer_for(q, pick, form, i):
    text = (form.get(f"t{i}") or "").strip()
    if pick != "__form__":
        return pick + (f"（补充：{text}）" if text else "")
    if q.get("multiSelect"):
        picks = [o["label"] for j, o in enumerate(q.get("options", [])) if form.get(f"c{j}")]
        if picks:
            return ", ".join(picks) + (f"（补充：{text}）" if text else "")
    return text or None


def watch_delivery():
    """Retry pushes to agy sessions, and flag answers no session picked up, so the user sees it on the card."""
    flagged = set()
    while True:
        time.sleep(60)
        for record in agy_records():
            try:
                deliver_agy(record["sessionId"])
            except Exception as error:
                log(f"agy retry failed: {error!r}")
        for record in records():
            if (record["status"] == "answered" and now() - record["answered_at"] > UNDELIVERED_AFTER
                    and record["qid"] not in flagged):
                flagged.add(record["qid"])
                try:
                    patch_card(record["message_id"], render(record))
                except Exception as error:
                    log(f"undelivered patch failed: {error!r}")


def hub():
    """Receive card clicks over Feishu's long connection and answer each with the redrawn card;
    file the user's thread replies for their sessions.
    Runs under `uv run --with lark-oapi`; the app secret is read from the login keychain
    (service agent-ask, account = app id)."""
    import lark_oapi as lark
    import lark_oapi.ws.client as lark_ws_client
    from lark_oapi.event.callback.model.p2_card_action_trigger import P2CardActionTriggerResponse

    def handle(data):
        e = data.event
        started = time.monotonic()
        value = e.action.value or {}
        try:
            card = on_action(e.operator.open_id, e.action.value, e.action.form_value)
        except Exception as error:  # one bad click must not kill the receiver
            log(f"action error: {error!r}")
            card = None
        log(f"click {value.get('qid')}[{value.get('i')}] {'redraw' if card else 'no-op'} "
            f"{(time.monotonic() - started) * 1000:.0f} ms")
        return P2CardActionTriggerResponse({"card": {"type": "raw", "data": card}} if card else {})

    app_id = config()["app_id"]
    secret = subprocess.run(["security", "find-generic-password", "-s", "agent-ask", "-a", app_id, "-w"],
                            capture_output=True, text=True, check=True).stdout.strip()
    def handle_message(data):
        e = data.event
        m = e.message
        try:
            sender = e.sender.sender_id.open_id if e.sender and e.sender.sender_id else None
            log(on_message(sender, {k: getattr(m, k, None) for k in
                                    ("message_id", "root_id", "parent_id", "chat_id", "message_type", "content")}))
            for sid in {i["sid"] for i in inbox_items() if i["status"] == "pending" and i.get("host") == "agy"}:
                threading.Thread(target=deliver_agy, args=(sid,)).start()  # agy has no hook to collect it
        except Exception as error:  # one bad message must not kill the receiver
            log(f"message error: {error!r}")

    handler = (lark.EventDispatcherHandler.builder("", "").register_p2_card_action_trigger(handle)
               .register_p2_im_message_receive_v1(handle_message).build())
    sdk_file = logging.FileHandler(LOG)  # connection drops and reconnects; launchd drops stderr
    sdk_file.setFormatter(logging.Formatter("%(asctime)s %(message)s", "%Y-%m-%d %H:%M:%S"))
    sdk_file.addFilter(lambda r: setattr(r, "msg", re.sub(r"\?\S*", "", str(r.msg))) or True)  # url carries a ticket
    logging.getLogger("Lark").addHandler(sdk_file)
    log("hub start")
    threading.Thread(target=watch_delivery, daemon=True).start()

    class FeishuLink(lark.ws.Client):
        """Clash Verge re-applying its network config silently kills the socket (no close frame), so the
        SDK only notices when keepalive times out (websockets default 20 s + 20 s), then the server config
        adds up to 30 s random jitter and 120 s between retries: about a minute of lost clicks per drop.
        One connection per Mac needs no jitter; ping fast and retry fast."""

        def _configure(self, conf):
            super()._configure(conf)
            self._reconnect_nonce = min(self._reconnect_nonce, 1)
            self._reconnect_interval = min(self._reconnect_interval, 10)

    _sdk_connect_kwargs = lark_ws_client._ws_connect_kwargs
    lark_ws_client._ws_connect_kwargs = lambda *a: {**_sdk_connect_kwargs(*a), "ping_interval": 5, "ping_timeout": 5}
    FeishuLink(app_id, secret, event_handler=handler, log_level=lark.LogLevel.INFO).start()


def store_secret():
    """Move the app secret from the clipboard into the login keychain without printing it."""
    secret = subprocess.run(["pbpaste"], capture_output=True, text=True).stdout.strip()
    if not re.fullmatch(r"[A-Za-z0-9]{20,64}", secret):
        sys.exit("剪贴板里不像 App Secret：先在开放平台「凭证与基础信息」点 App Secret 旁的复制按钮")
    app_id = config()["app_id"]
    subprocess.run(["security", "-i"], input=f"add-generic-password -U -s agent-ask -a {app_id} -w {secret}\n",
                   text=True, check=True, capture_output=True)
    subprocess.run(["pbcopy"], input="", text=True, check=True)
    print(f"已存入钥匙串（服务 agent-ask，账户 {app_id}），剪贴板已清空")


def notify(text):
    if os.environ.get("ANTIGRAVITY_CONVERSATION_ID"):  # an agy agent's command; it may run under a Claude
        agy = agy_register(quiet=True) or {}
        own = {"name": agy.get("name"), "sessionId": agy.get("sessionId")}
    else:
        own = owning_session() or {}
    name = own.get("name") or ""
    if not (os.environ.get("TMUX") and name.endswith(SCOPE_SUFFIX)):
        print(f"没有发出：只有 tmux 里名字以 {SCOPE_SUFFIX} 结尾的会话能推飞书（当前：{name or '找不到会话'}）")
        return 1
    text = text.strip()
    if not text or len(text) > MAX_NOTIFY:
        print(f"没有发出：通知要一两句白话，现在 {len(text)} 字（上限 {MAX_NOTIFY}）")
        return 1
    data = lark(["im", "+messages-send", "--chat-id", config()["chat_id"], "--markdown", "-"],
                stdin=f"📣 **{name}**：{text}")
    if data.get("message_id") and own.get("sessionId"):
        remember_thread(data["message_id"], own["sessionId"], name, f"你 {hhmm(now())} 的推送")
    log(f"notify {name} {len(text)} chars")
    print("已推到用户飞书")
    return 0


def make_groups():
    """Create a group with the user for every running session that has none; the hub routes by chat id."""
    cfg = config()
    have = set((cfg.get("groups") or {}).values()) | set(cfg.get("no_group") or [])  # the user said these need none
    for name in live_sessions():
        if name in have:
            continue
        data = lark(["im", "+chat-create", "--name", name, "--users", cfg["user_open_id"],
                     "--owner", cfg["user_open_id"], "--description", f"在这里说的话直接发给 {name}，它的回复也发在这里"])
        chat = data.get("chat_id")
        if not chat:
            print(f"{name}: 建群没拿到 chat_id：{json.dumps(data, ensure_ascii=False)[:200]}")
            return 1
        with locked():
            cfg = config()
            cfg.setdefault("groups", {})[chat] = name
            tmp = f"{CONFIG}.{os.getpid()}.tmp"
            json.dump(cfg, open(tmp, "w"), ensure_ascii=False, indent=1)
            os.replace(tmp, CONFIG)
        log(f"group {chat} for {name}")
        print(f"{name}: 建好了")
    for chat, name in (config().get("groups") or {}).items():
        print(f"{chat}  {name}")
    return 0


def withdraw(qid, reason):
    with locked():
        record = load(qid)
        if not record or record["status"] != "pending":
            print(f"{qid}: 不在待答状态（{record and record['status']}）")
            return 1
        record["status"], record["withdraw_reason"] = "withdrawn", reason
        save(record)
    patch_card(record["message_id"], render(record))
    refresh_summary()
    print(f"{qid}: 已撤回")
    return 0


def main(argv):
    mode = argv[1] if len(argv) > 1 else "list"
    if mode == "hook-ask":
        return hook_ask(sys.stdin.read())
    if mode == "hook-wait":
        return hook_wait(sys.stdin.read())
    if mode == "hook-deliver":
        return hook_deliver(sys.stdin.read())
    if mode == "hook-session":
        return hook_session(sys.stdin.read())
    if mode == "notify":
        if len(argv) < 3 or argv[2].startswith("-") and argv[2] != "-":
            print('用法：agent-ask notify "一两句白话"，或 agent-ask notify - 从 stdin 读。没有推送。')
            return 1
        return notify(sys.stdin.read() if argv[2] == "-" else " ".join(argv[2:]))
    if mode == "hook-reply":
        return hook_reply(sys.stdin.read())
    if mode == "hook-listen":
        return hook_listen(sys.stdin.read())
    if mode == "agy-session":
        return agy_session(sys.stdin.read())
    if mode == "agy-register":
        return 0 if agy_register() else 1
    if mode == "agy-ask":
        return agy_ask(sys.stdin.read())
    if mode == "agy-reply":
        return agy_reply(sys.stdin.read())
    if mode == "hub":
        return hub()
    if mode == "store-secret":
        return store_secret()
    if mode == "groups":
        return make_groups()
    if mode == "withdraw" and len(argv) >= 3:
        return withdraw(argv[2], " ".join(argv[3:]))
    if mode == "list":
        for r in records():
            if r["status"] in ("pending", "answered"):
                print(f"{r['qid']}  {r['status']:<9} {hhmm(r['asked_at'])}  {r['session']}  {r['questions'][0]['question'][:60]}")
        return 0
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv) or 0)
