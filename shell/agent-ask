#!/usr/bin/env python3
"""Route agent questions to the user's Feishu and deliver the answers back.

  agent-ask hub                    long-running receiver (launchd): card clicks -> answers
  agent-ask list                   questions still waiting for the user
  agent-ask withdraw QID [REASON]  an agent settled its own question; grey the card out
  agent-ask notify TEXT|-          push a message that needs no decision to the user's Feishu
  agent-ask store-secret           put the app secret from the clipboard into the keychain
  agent-ask groups                 give every running session its own Feishu group with the user

Hook modes (wired in ~/.claude/settings.json):
  hook-ask      PreToolUse AskUserQuestion: in scope, send one card per call and deny the
                terminal dialog; out of scope, leave the terminal dialog alone
  hook-wait     PreToolUse AskUserQuestion, asyncRewake: wait for that call's answers and
                wake the session with them (exit 2)
  hook-deliver  PostToolUse and UserPromptSubmit: hand over any answer the waiter has not
                delivered yet, so a busy session gets it at its next tool call
  hook-session  SessionStart: tell sessions in scope that `agent-ask notify` exists
  hook-reply    Stop: when a delivered answer had typed text (often a question back), or the user
                replied in a thread, post the session's reply in that thread, so the exchange
                stays on the phone
  hook-listen   Stop, asyncRewake: while the session is idle, wait for the user's replies in the
                threads of its cards and notifications and wake the session with them

Antigravity (agy) sessions (hooks in agents/agy/hooks.json, installed as ~/.gemini/config/hooks.json):
  agy-session   SessionStart: file the conversation under its tmux session's name and tell it to run
                `agent-ask agy-register` once
  agy-register  run by the agent itself: add the address and token the hub needs to message it
  agy-ask       PreToolUse ask_question: like hook-ask
  agy-reply     Stop: like hook-reply
  agy has no background wake-up hook, so instead of hook-wait/hook-deliver/hook-listen the hub pushes each
  answer and thread message into the conversation itself (deliver_agy), which also wakes an idle session.

Talking to a session: the user can type under a card, a notification or a posted reply (in its
thread, or quoting it); start a message in the private chat with a session's name ("training 看下
…", "@Compare：…"); or write in that session's own group (`agent-ask groups`). The hub files the
text for the session now running under that name; the session gets it at its next tool call
(hook-deliver) or, when idle, from hook-listen, and its reply goes back to the same thread or group.

Scope: Claude sessions running inside tmux whose name ends with "(R2V)", and agy running in a tmux
session whose name ends with "-r2v" ("probe-r2v" is "Probe (R2V)"). State lives in
XDG_STATE_HOME/agent-ask (default ~/.local/state/agent-ask); config.json there holds the
lark-cli profile used to send and patch cards, the app id, the private chat with the user
the user's open_id under that app, "groups": chat id -> session name, and "no_group": sessions that
should get none. The hub receives clicks itself (lark-oapi long
connection) so it can answer each click with the redrawn card.
"""
import contextlib, datetime, fcntl, glob, hashlib, json, logging, os, re, sqlite3, subprocess, sys, threading, time
from contextlib import contextmanager

ROOT = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "agent-ask")
QDIR = os.path.join(ROOT, "questions")
# One empty file per answer not yet delivered. The per-tool hook-deliver command in
# agents/claude/settings.json checks it in sh, so tool calls start Python only while one waits.
ANSWERED = os.path.join(ROOT, "answered")
CONFIG = os.path.join(ROOT, "config.json")
SUMMARY = os.path.join(ROOT, "summary.json")
INBOX = os.path.join(ROOT, "inbox")       # one file per user message typed in a thread; the name dedupes redeliveries
THREADS = os.path.join(ROOT, "threads")   # bot message id -> the session that sent it (notifications, posted replies)
LISTENERS = os.path.join(ROOT, "listen")  # per session, the pid of the hook-listen that waits for it
AGY_DIR = os.path.join(ROOT, "agy")       # per agy conversation: name, agy pid, and how to message it
AGY_HOME = os.environ.get("AGENT_ASK_AGY_HOME") or os.path.expanduser("~/.gemini/antigravity-cli")
LOG = os.path.join(ROOT, "hub.log")
LARK = os.environ.get("AGENT_ASK_LARK", "lark-cli")
SCOPE_SUFFIX = "(R2V)"
AGY_TMUX_SUFFIX = "-r2v"
TOOL = {"claude": "AskUserQuestion", "agy": "ask_question"}
LETTERS = "ABCDEFGH"
UNDELIVERED_AFTER = 5 * 60        # answered but not picked up: flag the card
# Questions are read later on a phone, without the session's context: keep them short.
MAX_QUESTION, MAX_DESCRIPTION, MAX_LABEL = 160, 100, 30
MAX_NOTIFY = 300                  # a notification is a line or two, not a report
MAX_REPLY = 3000                  # characters of the session's reply posted under the card
MAX_INBOUND = 2000                # characters of a thread reply handed to the session
LISTEN_SLICE = float(os.environ.get("AGENT_ASK_LISTEN_SLICE", "2"))
WAIT_SLICE = float(os.environ.get("AGENT_ASK_WAIT_SLICE", "1"))
WAIT_LIMIT = float(os.environ.get("AGENT_ASK_WAIT_LIMIT", str(23 * 3600)))


def now():
    return time.time()


def hhmm(ts):
    return time.strftime("%m-%d %H:%M", time.localtime(ts))


def config():
    return json.load(open(CONFIG))


@contextmanager
def locked():
    os.makedirs(QDIR, exist_ok=True)
    with open(os.path.join(ROOT, ".lock"), "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def qpath(qid):
    return os.path.join(QDIR, f"{qid}.json")


def load(qid):
    try:
        return json.load(open(qpath(qid)))
    except (OSError, ValueError):
        return None


def save(record):
    tmp = f"{qpath(record['qid'])}.{os.getpid()}.tmp"
    json.dump(record, open(tmp, "w"), ensure_ascii=False, indent=1)
    os.replace(tmp, qpath(record["qid"]))
    marker = os.path.join(ANSWERED, record["qid"])
    if record["status"] == "answered" and record.get("host") != "agy":  # the hub pushes agy answers itself
        os.makedirs(ANSWERED, exist_ok=True)
        open(marker, "a").close()
    elif os.path.exists(marker):
        os.remove(marker)


def records():
    out = []
    for path in glob.glob(os.path.join(QDIR, "*.json")):
        try:
            out.append(json.load(open(path)))
        except (OSError, ValueError):
            continue
    return sorted(out, key=lambda r: r["asked_at"])


def owning_session():
    """The session record of the Claude process this hook runs under. A resumed session can leave its
    old process alive under the same session id, so matching on the id alone may pick the old name."""
    pid = os.getppid()
    while pid > 1:
        path = os.path.expanduser(f"~/.claude/sessions/{pid}.json")
        if os.path.exists(path):
            try:
                return json.load(open(path))
            except (OSError, ValueError):
                return None
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        pid = int(out) if out.isdigit() else 1
    return None


def session_name(sid):
    own = owning_session()
    if own and own.get("sessionId") == sid and own.get("name"):
        return own["name"]
    for path in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            record = json.load(open(path))
        except (OSError, ValueError):
            continue
        if record.get("sessionId") == sid and record.get("name"):
            return record["name"]
    return (agy_load(sid) or {}).get("name")


def alive(pid):
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def live_sessions():
    """In-scope sessions running now, name -> session id; a restarted session resumes under a new id."""
    found = []
    for path in glob.glob(os.path.expanduser("~/.claude/sessions/*.json")):
        try:
            pid, record = int(os.path.basename(path)[:-5]), json.load(open(path))
        except (OSError, ValueError):
            continue
        name = record.get("name") or ""
        if name.endswith(SCOPE_SUFFIX) and record.get("sessionId") and alive(pid):
            found.append((record.get("startedAt") or 0, name, record["sessionId"]))
    found += [(r.get("startedAt") or 0, r["name"], r["sessionId"]) for r in agy_records()
              if r.get("name") and r.get("sessionId") and alive(r.get("pid"))]
    return {name: sid for _, name, sid in sorted(found)}  # the newest process wins a repeated name


# ---- Antigravity (agy) sessions -------------------------------------------------------
# agy keeps no session registry and has no background wake-up hook. SessionStart files each conversation
# under its tmux session's name; `agent-ask agy-register`, which the agent runs itself, adds the language
# server address and token that agy hands only to the agent's own commands (its hooks do not get them).
# With those the hub pushes answers into the conversation through `agy agentapi send-message`, an
# undocumented agy 1.5.12 command that also wakes an idle session.

def agy_load(conv):
    try:
        return json.load(open(os.path.join(AGY_DIR, f"{conv}.json")))
    except (OSError, ValueError, TypeError):
        return None


def agy_records():
    out = []
    for path in glob.glob(os.path.join(AGY_DIR, "*.json")):
        try:
            out.append(json.load(open(path)))
        except (OSError, ValueError):
            continue
    return out


def agy_save(record):
    os.makedirs(AGY_DIR, mode=0o700, exist_ok=True)
    os.chmod(AGY_DIR, 0o700)
    path = os.path.join(AGY_DIR, f"{record['sessionId']}.json")
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:  # holds the LS token
        json.dump(record, f, ensure_ascii=False)
    os.replace(tmp, path)


def agy_pid():
    """The agy process this hook or command runs under (AGENT_ASK_AGY_PID pins it in tests)."""
    if os.environ.get("AGENT_ASK_AGY_PID"):
        return int(os.environ["AGENT_ASK_AGY_PID"])
    pid = os.getppid()
    while pid > 1:
        # comm, not args: a path with spaces would split the command line
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True).stdout.split(None, 1)
        if len(out) < 2:
            return None
        if os.path.basename(out[1].strip()) == "agy":
            return pid
        pid = int(out[0])
    return None


def agy_scope():
    """The session name of an agy running in a "*-r2v" tmux session, else None."""
    if not (os.environ.get("TMUX") and os.environ.get("TMUX_PANE")):
        return None
    try:
        tmux = subprocess.run(["tmux", "display-message", "-p", "-t", os.environ["TMUX_PANE"], "#S"],
                              capture_output=True, text=True).stdout.strip()
    except OSError:
        return None
    return agy_name(tmux, (config().get("groups") or {}).values())


def agy_name(tmux, known):
    """The session name for tmux session `tmux`, spelled as in `known` (the names the groups are bound to)
    when only letter case differs: "autoeval-compare-r2v" is "AutoEval Compare (R2V)", not "Autoeval ..."."""
    words = [w for w in tmux[: -len(AGY_TMUX_SUFFIX)].replace("_", "-").split("-") if w]
    if not tmux.endswith(AGY_TMUX_SUFFIX) or not words:
        return None
    name = " ".join(w[:1].upper() + w[1:] for w in words) + f" {SCOPE_SUFFIX}"
    return next((k for k in known if k.casefold() == name.casefold()), name)


def agy_subagent(conv):
    """Whether `conv` is a subagent's conversation. It shares the agy process and pane of the session that
    started it, so filing it would route that session's Feishu messages to the subagent."""
    try:
        with contextlib.closing(sqlite3.connect(f"file:{AGY_HOME}/conversation_summaries.db?mode=ro", uri=True,
                                                timeout=5)) as db:
            row = db.execute("SELECT parent_conversation_id FROM conversation_summaries WHERE conversation_id=?",
                             (conv,)).fetchone()
    except sqlite3.Error:
        return False
    return bool(row and row[0])


def agy_current(conv):
    """The record of `conv` for the agy process running this hook, filed or refreshed, or None outside scope.
    A conversation resumed in a new process (gc, gr) keeps its file but not the old process's address and
    token; a new conversation in the same process (/clear) keeps them."""
    name, pid = agy_scope(), agy_pid()
    if not conv or not name or not pid or agy_subagent(conv):
        return None
    record = agy_load(conv) or {"sessionId": conv}
    if record.get("pid") != pid:
        for key in ("ls", "csrf", "exe"):
            record.pop(key, None)
        same = next((r for r in agy_records() if r.get("pid") == pid and r.get("csrf")), {})
        record.update({k: same[k] for k in ("ls", "csrf", "exe") if k in same}, startedAt=now() * 1000)
    record.update(name=name, pid=pid)
    agy_save(record)
    return record


# agy gives its address and token only to the agent's own commands, so a hook cannot register it anywhere.
AGY_REGISTER = "现在先运行一次 `agent-ask agy-register`，否则用户的答复送不回来。"
AGY_HINT = ("你在 tmux 常驻会话里，提问（ask_question）会发到用户飞书。用户多在手机上、看不到这里的对话，"
            "所以要他拍板的事都用 ask_question 问，别只写在回复里；调用后显示被拒绝、带「✅ 已发到用户飞书」，"
            "那是发送成功的回执，不是故障。问题不超过 160 字，每个选项不超过 130 字，超长会被打回并提示哪里要缩短。"
            + AGY_REGISTER +
