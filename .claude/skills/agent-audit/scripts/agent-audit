#!/usr/bin/env python3
"""Read-only measurements of how Claude Code sessions spend their turns.

Subcommands:
  sessions    main sessions with title, time range and size
  sources     what started each turn: user, peer session, schedule, own task receipt
  traffic     SendMessage counts between sessions (sender title -> recipient)
  delegation  subagents, skills, agent-team / cx use, subagents that edited files
  attention   what the sessions cost the user: messages, progress chasing, corrections,
              interrupts, questions and how long answers took

All counts come from ~/.claude/projects/*/*.jsonl (main sessions) and their
<session>/subagents/*.jsonl. Nothing is written.
"""
import argparse
import collections
import datetime as dt
import glob
import json
import os
import re
import statistics
import sys

ROOT = os.environ.get("AGENT_AUDIT_PROJECTS", os.path.expanduser("~/.claude/projects"))
CX_ROOT = os.environ.get("AGENT_AUDIT_CX", os.path.expanduser("~/.local/share/cx"))
SCRATCH = re.compile(r"^/(private/)?tmp/|/scratchpad/")
FROM_NAME = re.compile(r'from-name="([^"]*)"')
COMPACTION = ("This session is being continued", "Context handoff")

SOURCES = ["user", "peer", "scheduled", "task-receipt", "compaction", "system"]

# Heuristics over the user's own words; `attention --list` shows what they caught.
FOLLOWUP = re.compile(r"进度|进展|排上了吗|排队了吗|跑完了[吗没？?]|做完了[吗没？?]|完成了[吗没？?]|好了[吗没？?]|上线了[吗没？?]|到哪了|怎么样了|现在什么情况"
                      r"|还在跑|还没(上线|修|跑|做|完|好|出)|什么时候|几点|有结果了[吗没？?]")
CORRECTION = re.compile(r"不是这个意思|不是这样|你?(可能)?(搞|弄|理解|看|说|想)错|误解|纠正|我指的|我说的是|我是说|我想的是|我的意思是|不是.{0,20}而是"
                        r"|别这样|不要这样|这个不对|顺序不对|不对吧|不对，|^不对")
NOT_CORRECTION = re.compile(r"没理解错|没搞错|没看错|没记错|记错了")
PASTED = re.compile(r"<pasted_content\b.*?</pasted_content\b[^>]*>", re.S)
# Prompts other tools type into a session; origin says "human", the user did not write them.
AUTOMATED = re.compile(r"^(#+\s|你是独立|你是新的|这个会话刚被重启|\[cx )")
PROBE_CHARS = 300
ATTENTION = ["user", "automated", "followup", "correction", "interrupt", "asked", "answered",
             "wait_median_min", "wait_total_min", "queued", "relayed"]


def parse_day(s):
    return dt.date.fromisoformat(s) if s else None


def local_day(ts):
    t = dt.datetime.fromisoformat(ts.replace("Z", "+00:00"))
    return t.astimezone().date()


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return " ".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")
    return ""


def is_tool_result(content):
    return isinstance(content, list) and any(isinstance(b, dict) and b.get("type") == "tool_result" for b in content)


def main_sessions(project):
    for d in sorted(glob.glob(os.path.join(ROOT, "*"))):
        if project and project not in os.path.basename(d):
            continue
        for f in sorted(glob.glob(os.path.join(d, "*.jsonl"))):
            yield f


def records(path):
    with open(path, errors="ignore") as fh:
        for line in fh:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def scan(path):
    """One pass over a main session: title, time range, and classified turn starters."""
    title, first, last = None, None, None
    cron_prompts, pending_meta = set(), []
    events = []  # (day, source, sender)
    for d in records(path):
        if d.get("isSidechain"):
            continue
        if d.get("type") == "custom-title":
            title = d.get("customTitle") or title
            continue
        ts = d.get("timestamp")
        if ts:
            first = first or ts
            last = ts
        att = d.get("attachment")
        if isinstance(att, dict):
            if att.get("type") == "session_cron_carry":
                cron_prompts.update(t.get("prompt", "").strip() for t in att.get("tasks", []))
            elif att.get("type") == "queued_command":
                # Delivered mid-turn. Disjoint from the plain user records below.
                kind = (att.get("origin") or {}).get("kind")
                prompt = str(att.get("prompt", ""))
                events.append((att.get("timestamp") or ts, *classify(kind, prompt)))
            continue
        if d.get("type") == "assistant":
            for b in d.get("message", {}).get("content") or []:
                if isinstance(b, dict) and b.get("name") == "CronCreate":
                    cron_prompts.add(str((b.get("input") or {}).get("prompt", "")).strip())
            continue
        if d.get("type") != "user":
            continue
        content = d.get("message", {}).get("content")
        if is_tool_result(content):
            continue
        text = text_of(content)
        if not text or not ts:
            continue
        origin = d.get("origin")
        kind = origin.get("kind") if isinstance(origin, dict) else None
        if kind is None and d.get("isMeta"):
            # Scheduled prompts are isMeta records whose text equals a cron prompt; the
            # prompt set is only complete after the pass, so resolve these at the end.
            pending_meta.append((ts, text.strip()))
            continue
        events.append((ts, *classify(kind, text)))
    for ts, text in pending_meta:
        events.append((ts, "scheduled" if text in cron_prompts else "system", None))
    out = [(local_day(ts), src, sender) for ts, src, sender in events if ts]
    return {"title": title, "first": first, "last": last, "events": out}


def classify(kind, text):
    if kind == "human":
        return "user", None
    if kind == "peer" or "<cross-session-message" in text[:400]:
        m = FROM_NAME.search(text[:400])
        return "peer", m.group(1) if m else None
    if kind == "task-notification" or text.startswith("<task-notification>"):
        return "task-receipt", None
    if text.startswith(COMPACTION):
        return "compaction", None
    return "system", None


def own_words(text):
    """The part of a human message the user wrote; slash commands and pasted text are not."""
    if "<command-name>" in text[:200]:
        return ""
    return PASTED.sub("", text).strip()[:PROBE_CHARS]


def scan_attention(path, title):
    """Attention events of one main session: (timestamp, kind, value), plus classified messages."""
    events, asks = [], {}
    for d in records(path):
        if d.get("isSidechain"):
            continue
        ts = d.get("timestamp")
        att = d.get("attachment")
        if isinstance(att, dict):
            if att.get("type") == "queued_command" and (att.get("origin") or {}).get("kind") == "human":
                events.extend(human_events(att.get("timestamp") or ts, text_of(att.get("prompt", ""))))
            continue
        content = (d.get("message") or {}).get("content")
        if d.get("type") == "assistant" and isinstance(content, list):
            for b in content:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                inp = b.get("input") or {}
                if b.get("name") == "AskUserQuestion":
                    asks[b.get("id")] = ts
                    events.append((ts, "asked", None))
                elif b.get("name") == "Bash" and re.search(r"\bpresence ask\b", inp.get("command", "")):
                    events.append((ts, "queued", None))
                elif (b.get("name") == "SendMessage" and (title or "").startswith("Lead")
                      and str(inp.get("to", "")).startswith("Training") and "用户" in str(inp.get("message", ""))):
                    events.append((ts, "relayed", None))
        elif d.get("type") == "user":
            if isinstance(content, list):
                for b in content:
                    if isinstance(b, dict) and b.get("type") == "tool_result" and b.get("tool_use_id") in asks:
                        asked = asks.pop(b["tool_use_id"])
                        if not b.get("is_error") and asked and ts:
                            events.append((asked, "answered", minutes_between(asked, ts)))
            text = text_of(content)
            if text.startswith("[Request interrupted"):
                events.append((ts, "interrupt", None))
            elif isinstance(d.get("origin"), dict) and d["origin"].get("kind") == "human":
                events.extend(human_events(ts, text))
    return [e for e in events if e[0]]


def human_events(ts, text):
    words = own_words(text)
    if AUTOMATED.match(words):
        return [(ts, "automated", words)]
    out = [(ts, "user", words)]
    if FOLLOWUP.search(words):
        out.append((ts, "followup", words))
    if CORRECTION.search(words) and not NOT_CORRECTION.search(words):
        out.append((ts, "correction", words))
    return out


def minutes_between(a, b):
    parse = lambda s: dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    return (parse(b) - parse(a)).total_seconds() / 60


def in_window(day, args):
    return (not args.since or day >= args.since) and (not args.until or day <= args.until)


def selected(args):
    for f in main_sessions(args.project):
        sid = os.path.basename(f)[:-6]
        if args.session and not any(sid.startswith(s) for s in args.session):
            continue
        if os.path.getsize(f) == 0:
            continue
        info = scan(f)
        if args.title and not re.search(args.title, info["title"] or ""):
            continue
        info["events"] = [e for e in info["events"] if in_window(e[0], args)]
        if not info["events"] and (args.since or args.until):
            continue
        yield sid, f, info


def cmd_sessions(args):
    rows = []
    for sid, f, info in selected(args):
        c = collections.Counter(e[1] for e in info["events"])
        rows.append({"session": sid[:8], "title": info["title"], "first": (info["first"] or "")[:16],
                     "last": (info["last"] or "")[:16], "mb": os.path.getsize(f) // 2**20, **{s: c[s] for s in SOURCES}})
    emit(args, rows, ["session", "title", "first", "last", "mb"] + SOURCES)


def cmd_sources(args):
    by = collections.defaultdict(collections.Counter)
    senders = collections.Counter()
    for sid, f, info in selected(args):
        for day, src, sender in info["events"]:
            key = str(day) if args.by == "day" else (info["title"] or sid[:8])
            by[key][src] += 1
            if src == "peer":
                senders[sender or "?"] += 1
    rows = [{"key": k, **{s: by[k][s] for s in SOURCES}} for k in sorted(by)]
    emit(args, rows, ["key"] + SOURCES)
    if not args.json and senders:
        print("\npeer senders: " + ", ".join(f"{n} {s}" for s, n in senders.most_common()))


def cmd_traffic(args):
    pairs, chars = collections.Counter(), collections.Counter()
    for sid, f, info in selected(args):
        sender = info["title"] or sid[:8]
        for d in records(f):
            if d.get("type") != "assistant" or d.get("isSidechain"):
                continue
            ts = d.get("timestamp")
            if not ts or not in_window(local_day(ts), args):
                continue
            for b in d.get("message", {}).get("content") or []:
                if isinstance(b, dict) and b.get("name") == "SendMessage":
                    inp = b.get("input") or {}
                    k = (sender, str(inp.get("to")))
                    pairs[k] += 1
                    chars[k] += len(str(inp.get("message", "")))
    rows = [{"from": a, "to": b, "messages": n, "chars": chars[(a, b)]} for (a, b), n in pairs.most_common()]
    emit(args, rows, ["from", "to", "messages", "chars"])


def cmd_delegation(args):
    agents, skills, bash = collections.Counter(), collections.Counter(), collections.Counter()
    writers, total_sub = 0, 0
    patterns = {"agent-team": "agent-team", "cx start": r"\bcx start\b", "cx send": r"\bcx send\b"}
    for sid, f, info in selected(args):
        for d in records(f):
            if d.get("type") != "assistant" or d.get("isSidechain"):
                continue
            ts = d.get("timestamp")
            if not ts or not in_window(local_day(ts), args):
                continue
            for b in d.get("message", {}).get("content") or []:
                if not isinstance(b, dict) or b.get("type") != "tool_use":
                    continue
                inp = b.get("input") or {}
                if b.get("name") in ("Agent", "Task"):
                    agents[inp.get("subagent_type") or "(default)"] += 1
                elif b.get("name") == "Skill":
                    skills[inp.get("skill")] += 1
                elif b.get("name") == "Bash":
                    for k, p in patterns.items():
                        bash[k] += bool(re.search(p, inp.get("command", "")))
        for sub in glob.glob(os.path.join(f[:-6], "subagents", "*.jsonl")):
            first = next((d.get("timestamp") for d in records(sub) if d.get("timestamp")), None)
            if not first or not in_window(local_day(first), args):
                continue
            total_sub += 1
            writers += any(
                isinstance(b, dict) and b.get("name") in ("Edit", "Write")
                and not SCRATCH.search(str((b.get("input") or {}).get("file_path", "")))
                for d in records(sub) if d.get("type") == "assistant"
                for b in d.get("message", {}).get("content") or [])
    rows = [{"metric": f"agent:{k}", "count": n} for k, n in agents.most_common()]
    rows += [{"metric": f"skill:{k}", "count": n} for k, n in skills.most_common()]
    rows += [{"metric": f"bash:{k}", "count": n} for k, n in bash.items()]
    rows += [{"metric": "subagents", "count": total_sub}, {"metric": "subagents editing non-scratch files", "count": writers}]
    for line in sorted(glob.glob(os.path.join(CX_ROOT, "*"))) if args.cx else []:
        names = os.listdir(line) if os.path.isdir(line) else []
        # ask-NNN.md.sent marks a relayed question; count each question once.
        msgs, replies, asks = (sum(1 for x in names if re.fullmatch(rf"{k}-\d+\.md", x)) for k in ("msg", "reply", "ask"))
        rows.append({"metric": f"cx:{os.path.basename(line)}", "count": f"msgs={msgs} replies={replies} asks={asks}"})
    emit(args, rows, ["metric", "count"])


def cmd_attention(args):
    by = collections.defaultdict(collections.Counter)
    waits = collections.defaultdict(list)
    listed = []
    for sid, f, info in selected(args):
        name = info["title"] or sid[:8]
        for ts, kind, value in scan_attention(f, info["title"]):
            day = local_day(ts)
            if not in_window(day, args):
                continue
            if args.list == kind:
                listed.append({"at": ts[:16], "session": name, "text": value})
            key = str(day) if args.by == "day" else name
            by[key][kind] += 1
            if kind == "answered":
                waits[key].append(value)
    if args.list:
        return emit(args, sorted(listed, key=lambda r: r["at"]), ["at", "session", "text"])
    rows = []
    for k in sorted(by):
        w = waits[k]
        rows.append({"key": k, **{c: by[k][c] for c in ATTENTION},
                     "wait_median_min": round(statistics.median(w), 1) if w else 0, "wait_total_min": round(sum(w), 1)})
    emit(args, rows, ["key"] + ATTENTION)


def emit(args, rows, cols):
    if args.json:
        json.dump(rows, sys.stdout, ensure_ascii=False, indent=1, default=str)
        print()
        return
    print("\t".join(cols))
    for r in rows:
        print("\t".join(str(r.get(c, "")) for c in cols))


def main(argv=None):
    p = argparse.ArgumentParser(prog="agent-audit", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("command", choices=["sessions", "sources", "traffic", "delegation", "attention"])
    p.add_argument("--project", help="substring of the ~/.claude/projects directory name")
    p.add_argument("--session", action="append", help="session id prefix (repeatable)")
    p.add_argument("--title", help="regex on the session title (/rename)")
    p.add_argument("--since", type=parse_day, help="YYYY-MM-DD, local time, inclusive")
    p.add_argument("--until", type=parse_day, help="YYYY-MM-DD, local time, inclusive")
    p.add_argument("--by", choices=["session", "day"], default="session", help="sources, attention: group rows")
    p.add_argument("--cx", action="store_true", help="delegation: add cx executor line stats")
    p.add_argument("--list", choices=["user", "followup", "correction"], help="attention: print the messages of this kind")
    p.add_argument("--json", action="store_true")
    args = p.parse_args(argv)
    {"sessions": cmd_sessions, "sources": cmd_sources, "traffic": cmd_traffic, "delegation": cmd_delegation, "attention": cmd_attention}[args.command](args)


if __name__ == "__main__":
    main()
