  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "markup.list.bullet",
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#ff7589"
      }
    },
    {
      "scope": [
        "string",
        "markup.raw",
        "markup.inline.raw",
        "punctuation.definition.string",
        "string.regexp",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#85c2ff"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#f2be59"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3fd1df"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "punctuation.definition.decorator",
        "entity.name.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#b17aff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#3fd1df"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#f2f2f2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.other.attribute-name",
        "variable.language"
      ],
      "settings": {
        "foreground": "#5aaeff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#00b889"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#5aaeff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#5aaeff",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9e9e9e"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#00b889"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted",
        "meta.diff.header.from-file",
        "invalid"
      ],
      "settings": {
        "foreground": "#ff7589"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#f2be59"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#b17aff"
      }
    }
  ]
}
