  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "markup.list.bullet",
        "punctuation.definition.list.begin"
      ],
      "settings": {
        "foreground": "#bf1831"
      }
    },
    {
      "scope": [
        "string",
        "markup.raw",
        "markup.inline.raw",
        "punctuation.definition.string",
        "string.regexp",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#005ed7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#956000"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#007b87"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "punctuation.definition.decorator",
        "entity.name.decorator",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#722ccc"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.class.jsdoc"
      ],
      "settings": {
        "foreground": "#007b87"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#1f1f1f"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.other.attribute-name",
        "variable.language"
      ],
      "settings": {
        "foreground": "#005ed7"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#007a56"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5c5c5c"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "markup.heading punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#005ed7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#005ed7",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5c5c5c"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "punctuation.definition.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#007a56"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "punctuation.definition.deleted",
        "meta.diff.header.from-file",
        "invalid"
      ],
      "settings": {
        "foreground": "#bf1831"
      }
    },
    {
      "scope": [
        "markup.changed",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "#956000"
      }
    },
    {
      "scope": [
        "meta.diff.range",
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#722ccc"
      }
    }
  ]
}
