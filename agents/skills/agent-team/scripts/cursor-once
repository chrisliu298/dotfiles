#!/usr/bin/env zsh

emulate -L zsh
setopt pipe_fail

if [[ "${CODEX_REVIEW_SUBAGENT_ACTIVE:-}" == 1 ]]; then
    print -u2 'agent-team (cursor): recursive Codex subagent delegation is blocked'
    exit 126
fi

cursor_agent_bin="${CURSOR_AGENT_BIN:-cursor-agent}"

if [[ "$cursor_agent_bin" == */* ]]; then
    cursor_agent_available=false
    [[ -x "$cursor_agent_bin" ]] && cursor_agent_available=true
else
    cursor_agent_available=false
    (( $+commands[$cursor_agent_bin] )) && cursor_agent_available=true
fi

if [[ "$cursor_agent_available" == false ]]; then
    print -u2 "agent-team (cursor): cursor-agent is not installed or not on PATH"
    exit 127
fi

cursor_args=()
output_format=text

usage() {
    print -u2 'usage: cursor-once [cursor-agent options] [prompt]'
    print -u2 '       cursor-once [cursor-agent options] < prompt.md'
    print -u2 '       model=gemini-4-argon-high, effort=high, native Agent mode (fixed)'
}

while (( $# > 0 )); do
    case "$1" in
        --trust)
            shift
            ;;
        --mode|--mode=*|--plan)
            print -u2 'agent-team (cursor): uses native Agent mode with review permissions; mode selection is not supported'
            exit 2
            ;;
        --output-format)
            (( $# >= 2 )) || { usage; exit 2; }
            output_format="$2"
            shift 2
            ;;
        --output-format=*)
            output_format="${1#*=}"
            shift
            ;;
        --stream-partial-output)
            # Partial events are captured internally and never prove completion.
            shift
            ;;
        --effort|--effort=*|--model|--model=*)
            print -u2 'agent-team (cursor): model is fixed to Claude Opus 5.5 high; model and effort options are not supported'
            exit 2
            ;;
        --)
            shift
            cursor_args+=(-- "$@")
            break
            ;;
        *)
            cursor_args+=("$1")
            shift
            ;;
    esac
done

if [[ "$output_format" != text && "$output_format" != json && "$output_format" != stream-json ]]; then
    print -u2 'agent-team (cursor): output format must be text, json, or stream-json'
    exit 2
fi

if (( ! $+commands[jq] || ! $+commands[node] )); then
    print -u2 'agent-team (cursor): jq and Node.js are required'
    exit 127
fi

if [[ -t 0 && ${#cursor_args} -eq 0 ]]; then
    usage
    exit 2
fi

diagnostic_file="$(mktemp "${TMPDIR:-/tmp}/agent-team-cursor.err.XXXXXX")" || exit 1
events_file="$(mktemp "${TMPDIR:-/tmp}/agent-team-cursor.events.XXXXXX")" || exit 1
config_dir="$(mktemp -d "${TMPDIR:-/tmp}/agent-team-cursor-config.XXXXXX")" || exit 1
cleanup() {
    rm -f -- "$diagnostic_file" "$events_file"
    rm -rf -- "$config_dir"
}
trap cleanup EXIT HUP INT TERM
node "${0:A:h}/cursor-session.mjs" config "$config_dir" || exit $?

export CODEX_REVIEW_SUBAGENT_ACTIVE=1

completion_instruction='Complete the entire read-only assignment in this turn. Return the requested findings, evidence, and final deliverable; do not end with an acknowledgement, an opening remark, or a promise to investigate later. If blocked, state the concrete blocker and the work actually completed.'
run_cursor() {
    local -a launch_args=(--print --trust --force --sandbox disabled --approve-mcps --model gemini-4-argon-high
        --output-format stream-json --stream-partial-output "${cursor_args[@]}")
    local prompt=
    [[ -t 0 ]] || prompt="$(command cat)" || return $?
    prompt+=$'\n\n'"$completion_instruction"
    # Send one combined prompt; no later stdin chunk can become a follow-up.
    (( ${cursor_args[(I)--]} )) || launch_args+=(--)
    CURSOR_CONFIG_DIR="$config_dir" "$cursor_agent_bin" "${launch_args[@]}" "$prompt" < /dev/null
}

run_cursor > "$events_file" 2> >(tee "$diagnostic_file" >&2)
exit_status=$?

# Only a valid stream ending in a non-empty successful result proves a finished turn.
# Assistant deltas and stream-close diagnostics do not establish completion.
result_event="$(jq -ce -s '
    last | select(.type == "result" and .is_error == false)
    | select(.result | type == "string")
    | select(.result | test("\\S"))
' "$events_file" 2>/dev/null)"
session_id="$(jq -r 'select(.type == "system" and .subtype == "init" or .type == "result")
    | .session_id? | select(type == "string" and length > 0)' \
    "$events_file" 2>/dev/null | tail -n 1)"
[[ -n "$session_id" ]] && print -u2 -r -- "agent-team (cursor): session_id=$session_id"

if [[ -z "$result_event" ]]; then
    print -u2 'agent-team (cursor): no complete terminal result; the response is unfinished'
    (( exit_status == 0 )) && exit_status=1
elif (( exit_status != 0 )) && command grep -q 'WritableIterable is closed' "$diagnostic_file"; then
    print -u2 'agent-team (cursor): recovered verified terminal result after its output stream closed'
    exit_status=0
fi

if [[ -n "$result_event" ]]; then
    case "$output_format" in
        text) print -r -- "$result_event" | jq -r '.result' ;;
        json) print -r -- "$result_event" ;;
        stream-json) command cat "$events_file" ;;
    esac
fi

if (( exit_status != 0 )) && grep -q 'SecItemCopyMatching failed -50' "$diagnostic_file"; then
    print -u2 'agent-team (cursor): Cursor could not read its macOS Keychain login. If this command is running in a restricted sandbox, rerun this helper with narrowly scoped unsandboxed execution; do not replace the login or model based on this error alone.'
fi

exit "$exit_status"
