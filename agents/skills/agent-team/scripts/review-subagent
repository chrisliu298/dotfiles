#!/usr/bin/env zsh

emulate -L zsh
setopt pipe_fail

harness="$1"
shift
case "$harness" in
    claude) model=opus effort=high ;;
    gpt) model=gpt-6-astra effort=high ;;
    cursor) model=gemini-4-argon-high effort=high ;;
    muse) model=muse-wonder-full-1.0 effort=high ;;
    # DeepSeek maps xhigh to high, so high is its real top tier below max.
    ds) model='deepseek-flash[1m]' effort=high ;;
    *) print -u2 'unknown review harness'; exit 2 ;;
esac
# Diagnostics name the public entrypoint; temp files carry the backend.
helper=agent-team
tmp="agent-team-${harness}"
prefix="${harness}-review-"
# Sessions started before the gemini backend was renamed to cursor keep their old names.
legacy=
[[ "$harness" == cursor ]] && legacy=gemini
runner="${0:A}"
codex_cli="$HOME/.local/bin/codex"
notifier="${runner:h}/turn-notifier"
cursor_cli="${CURSOR_AGENT_BIN:-cursor-agent}"
muse_cli="${MUSE_BIN:-muse}"

check_harness_cli() {
    if [[ "$harness" == cursor ]]; then
        if (( ! $+commands[jq] || ! $+commands[node] )); then
            print -u2 "$helper: jq and Node.js are required"
            return 127
        fi
        if [[ "$cursor_cli" == */* && -f "$cursor_cli" && -x "$cursor_cli" ]]; then
            cursor_cli="${cursor_cli:A}"
        elif (( $+commands[$cursor_cli] )); then
            cursor_cli="${commands[$cursor_cli]}"
        else
            print -u2 "$helper: cursor-agent is not installed or not on PATH"
            return 127
        fi
        return 0
    fi
    if [[ "$harness" == muse ]]; then
        if [[ "$muse_cli" == */* && -f "$muse_cli" && -x "$muse_cli" ]]; then
            muse_cli="${muse_cli:A}"
        elif (( $+commands[$muse_cli] )); then
            muse_cli="${commands[$muse_cli]}"
        else
            print -u2 "$helper: muse is not installed or not on PATH"
            return 127
        fi
        return 0
    fi
    [[ "$harness" == gpt ]] || return 0
    if [[ ! -x "$codex_cli" ]]; then
        print -u2 "$helper: managed Codex CLI missing; run ./dotfiles.sh"
        return 127
    fi
    local version
    version="$("$codex_cli" --version)" || return
    version="${version#codex-cli }"
    autoload -Uz is-at-least
    if [[ "$version" != <->.<->.<->* ]] || ! is-at-least 0.159.2 "$version"; then
        print -u2 "$helper: Codex CLI 0.159.2+ required for $model (found $version); run xu or codex update"
        return 2
    fi
}

parse_options() {
    output_format=text
    while (( $# )); do
        case "$1" in
            --trust)
                [[ "$harness" == cursor ]] || { usage; return 2; }
                shift
                ;;
            --effort|--model|--output-format)
                local option="$1" value="${2:-}"
                if (( $# < 2 )); then usage; return 2; fi
                if [[ "$harness" == (cursor|muse) && "$option" != --output-format ]]; then
                    print -u2 "$helper: model and effort are fixed; selection options are not supported"
                    return 2
                fi
                case "$option" in
                    --effort) [[ "$value" == "$effort" ]] || { print -u2 "$helper: effort is fixed to $effort"; return 2; } ;;
                    --model) [[ "$value" == "$model" ]] || { print -u2 "$helper: model is fixed to $model"; return 2; } ;;
                    --output-format) [[ "$action" == --once && ( "$value" == text || "$value" == json ) ]] || { usage; return 2; }; output_format="$value" ;;
                esac
                shift 2
                ;;
            *) usage; return 2 ;;
        esac
    done
}

# Claude Code asks whether to trust an unfamiliar launch directory before the first turn, and
# nobody is at the pane to answer. Trust it for the run, as cursor (--trust) and muse already do:
# move the selection to Yes, confirm once it is selected, and stop once the main screen is up.
accept_trust() {
    local screen
    repeat 300; do
        screen="$(tmux capture-pane -p -t "$TMUX_PANE")" || return
        if [[ "$screen" == *'❯ Yes, I trust this folder'* ]]; then
            tmux send-keys -t "$TMUX_PANE" Enter
            return
        elif [[ "$screen" == *'❯ No, exit'* ]]; then
            tmux send-keys -t "$TMUX_PANE" Down
            sleep 0.5
        elif [[ "$screen" == *'bypass permissions'* ]]; then
            return
        fi
        sleep 0.2
    done
}

launch() {
    local mode="$1" prompt="$2"
    export CODEX_REVIEW_SUBAGENT_ACTIVE=1
    if [[ "$harness" == (claude|ds) ]]; then
        # DeepSeek runs Claude Code through the user's `ds` launcher, so it shares this path.
        local launcher=c
        [[ "$harness" == ds ]] && launcher=ds
        source "$HOME/.functions" || return 127
        (( $+functions[$launcher] )) || { print -u2 "$helper: $launcher is not defined"; return 127; }
        if [[ "$mode" == once ]]; then
            print -rn -- "$prompt" | "$launcher" -p --no-session-persistence --model "$model" --effort "$effort"
        else
            accept_trust &
            local watcher=$!
            # The Stop hook records each finished turn for `wait`.
            "$launcher" --model "$model" --effort "$effort" \
                --settings "{\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"'$notifier'\"}]}]}}" \
                -- "$prompt"
            local rc=$?
            kill "$watcher" 2>/dev/null || true
            wait "$watcher" 2>/dev/null || true
            return "$rc"
        fi
    elif [[ "$harness" == muse ]]; then
        # Match the user's `m` launcher: no approvals (which would hang an unattended turn), no
        # sandbox, full network. Read-only scope is an assignment instruction, as for Claude.
        local -a options=(--model "$model" --reasoning-effort "$effort" --yolo)
        if [[ "$mode" == once ]]; then
            # exec takes the prompt as an argument (stdin is not read), so no prompt file can leak.
            command "$muse_cli" exec "${options[@]}" --no-session-log -- "$prompt"
        else
            # Stop records each finished turn for `wait`, as for Claude Code; StopFailure records a
            # turn that ended in an error. Muse scrubs the hook environment, so the command carries
            # the turn directory itself, JSON-escaped for any temp path.
            local hook="REVIEW_SUBAGENT_TURN_DIR=${(qq)REVIEW_SUBAGENT_TURN_DIR} ${(qq)notifier}"
            hook="${${hook//\\/\\\\}//\"/\\\"}"
            local entry="[{\"hooks\":[{\"type\":\"command\",\"command\":\"$hook\"}]}]"
            command "$muse_cli" "${options[@]}" -c "hooks={\"Stop\":$entry,\"StopFailure\":$entry}" -- "$prompt"
        fi
    elif [[ "$harness" == cursor ]]; then
        if [[ "$mode" == once ]]; then
            # The internal one-shot adapter reinstates the sentinel for its Cursor child.
            print -rn -- "$prompt" | CODEX_REVIEW_SUBAGENT_ACTIVE=0 CURSOR_AGENT_BIN="$cursor_cli" \
                "${runner:h}/cursor-once"
        else
            # Native input supports steering the active turn. The primary transcript's
            # explicit turn_ended marker supplies the full completion signal for wait.
            prompt+=$'\n\nComplete the entire read-only assignment in this turn. Return the requested findings, evidence, and final deliverable; do not end with an acknowledgement, an opening remark, or a promise to investigate later. If blocked, state the concrete blocker and the work actually completed.'
            node "${runner:h}/cursor-session.mjs" watch "$REVIEW_SUBAGENT_TURN_DIR" &
            local watcher=$!
            CURSOR_CONFIG_DIR="$REVIEW_SUBAGENT_TURN_DIR/cursor-config" \
                "$cursor_cli" --trust --force --sandbox disabled --approve-mcps --model "$model" \
                --resume "$(<"$REVIEW_SUBAGENT_TURN_DIR/conversation")" -- "$prompt"
            local rc=$?
            kill "$watcher" 2>/dev/null || true
            wait "$watcher" 2>/dev/null || true
            return "$rc"
        fi
    else
        # Match the user's `x` launcher (--yolo): no approvals, no sandbox, full network.
        # Read-only scope is an assignment instruction, as for Claude and Cursor.
        local -a options=(--dangerously-bypass-approvals-and-sandbox --model "$model"
            -c "model_reasoning_effort=\"$effort\"" -c 'shell_environment_policy.inherit="all"')
        if [[ "$mode" == once ]]; then
            print -rn -- "$prompt" | command "$codex_cli" "${options[@]}" exec --ephemeral --skip-git-repo-check --color never -
        else
            # notify records each finished turn for `wait`, replacing any configured notifier.
            command "$codex_cli" "${options[@]}" -c "notify=[\"$notifier\"]" --no-alt-screen -- "$prompt"
        fi
    fi
}

usage() {
    print -u2 "usage: ${runner:t} $harness [start] < prompt.md  (default: tmux)"
    print -u2 "       ${runner:t} $harness --once [--output-format text|json] < prompt.md"
    print -u2 "       ${runner:t} $harness send SESSION < message.md"
    print -u2 "       ${runner:t} $harness wait SESSION [--timeout SECONDS]  (default: 3600)"
    print -u2 "       ${runner:t} $harness list | capture|status|interrupt|stop SESSION"
    print -u2 "       model=$model, effort=$effort (fixed)"
}

tracker="${runner:h}/paste-mode-tracker"

# Released tmux has no format for bracketed-paste mode, so start mirrors it
# through pipe-pane into a state file; a missing or empty file means not ready.
input_ready() {
    local state_file value=0
    state_file="$(tmux show-options -v -t "$session" @review_paste_state 2>/dev/null)" || true
    [[ -n "$state_file" && -r "$state_file" ]] && read -r value < "$state_file"
    print -r -- "${value:-0}"
}

# Footer of Cursor's queued follow-ups, e.g. `│ +8 more lines · enter steer · …`.
cursor_footer='^[[:space:]]*│[[:space:]]*(\+[0-9]+ more lines? ·[[:space:]]*)?enter '

# Cursor's input box: from its `→` prompt line to the bottom border.
cursor_draft() {
    tmux capture-pane -p -t "$pane" | command awk '/^[[:space:]]*→ /{on=1} on&&/▀/{exit} on'
}

# Muse shows these while a turn runs or input waits for one; a finished turn alone does not
# answer queued input, which Muse runs as its own turn unless it steers it into the current one.
muse_busy() {
    tmux capture-pane -p -t "$pane" | command grep -Eq 'esc to interrupt|Queued input'
}

# Text in Muse's input box: from its last `❯` line to the bottom border, without the prompt mark.
muse_draft() {
    tmux capture-pane -p -t "$pane" | command awk '
        { line[NR] = $0 } /^❯/ { box = NR }
        END { for (i = box; box && i <= NR; i++) { if (i > box && line[i] ~ /^─/) break
              text = line[i]; if (i == box) sub(/^❯ ?/, "", text); out = out text }
              gsub(/[[:space:]]/, "", out); printf "%s", out }'
}

# Count of finished turns recorded by turn-notifier for the current session.
turns_done() {
    local turn_dir value=0
    turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir 2>/dev/null)" || true
    [[ -n "$turn_dir" && -r "$turn_dir/done" ]] && read -r value < "$turn_dir/done"
    print -r -- "${value:-0}"
}

# Callers that poll the screen read a truncated, still-rendering view; point them at `wait`.
turn_hint() {
    local sent delivery
    delivery="$(tmux show-options -v -t "$session" @review_send_state 2>/dev/null)" || delivery=submitted
    if [[ "$delivery" == failed ]]; then
        print -u2 "$helper: latest message delivery failed; wait reports that failure"
        return 0
    fi
    sent="$(tmux show-options -v -t "$session" @review_sent 2>/dev/null)" || return 0
    if [[ "$delivery" != pending ]] && (( $(turns_done) > sent )); then
        print -u2 "$helper: turn finished; run \`$helper wait $session\` for the full final reply (the screen is a truncated render)"
    else
        print -u2 "$helper: turn running; run \`$helper wait $session\` to block until it finishes and print the full final reply"
    fi
}

# Network and provider failures that end a Muse or Cursor turn but leave the session idle with
# its context intact. Rate limits, usage limits, blocked models and aborts are not transient.
transient_failure='transport error|net-timeout|WritableIterable is closed|Connection stalled|Provider Error'
auto_continue_limit=2
continue_message='The previous turn ended early because of a transient network or provider error. Continue the same assignment from where it stopped without repeating completed work, and finish with the complete requested deliverable.'

# Resume a turn that ended in a transient failure by sending a continuation through `send`, at
# most $auto_continue_limit times per request; a caller's `send` starts a new request.
auto_continue() {
    local error="$1" count deadline output rc
    print -r -- "$error" | command grep -Eq "$transient_failure" || return 1
    # A continuation would replace a Cursor message that never joined the failed turn.
    [[ "$harness" == cursor && -e "$turn_dir/latest-message.json" ]] && return 1
    count="$(tmux show-options -v -t "$session" @review_auto_continued 2>/dev/null)" || count=0
    (( ${count:-0} < auto_continue_limit )) || return 1
    deadline=$(( SECONDS + 10 ))
    while [[ "$(input_ready)" != 1 ]] && (( SECONDS < deadline )); do sleep 0.1; done
    output="$(print -r -- "$continue_message" | "$runner" "$harness" send "$session" 2>&1 >/dev/null)"
    rc=$?
    # 124 means Cursor has the message but has not confirmed steering; `wait` keeps steering it.
    # The session was idle, so a fresh turn error during `send` means the continuation itself
    # failed after delivery; `wait` handles that error like any other.
    if (( rc != 0 && rc != 124 )) && [[ -s "$turn_dir/error" ]]; then
        tmux set-option -t "$session" @review_send_state submitted || return 1
    elif (( rc != 0 && rc != 124 )); then
        print -u2 -r -- "$helper: automatic continuation failed: $output"
        return 1
    fi
    tmux set-option -t "$session" @review_auto_continued $(( count + 1 )) || return 1
    print -u2 -r -- "$helper: ${error%%$'\n'*}; auto-continued $(( count + 1 ))/$auto_continue_limit"
}

action="${1:-start}"
(( $# )) && shift

if [[ "$action" == __run ]]; then
    if [[ "${REVIEW_SUBAGENT_TMUX_RUNNER:-}" != 1 || $# -ne 1 ]]; then
        exit 126
    fi
    scratch_dir="$1"
    for _ in {1..100}; do
        [[ -e "$scratch_dir/ready" ]] && break
        sleep 0.05
    done
    if [[ ! -e "$scratch_dir/ready" ]]; then
        print -u2 "$helper: startup handshake timed out"
        exit 1
    fi
    prompt_file="$scratch_dir/prompt.md"
    prompt="$(command cat "$prompt_file")" || exit 1
    command rm -f -- "$prompt_file"
    command rm -f -- "$scratch_dir/ready"
    command rmdir -- "$scratch_dir" 2>/dev/null || true

    unset REVIEW_SUBAGENT_TMUX_RUNNER
    launch interactive "$prompt"
    exit $?
fi

if [[ "${CODEX_REVIEW_SUBAGENT_ACTIVE:-}" == 1 ]]; then
    print -u2 "$helper: recursive Codex subagent delegation is blocked"
    exit 126
fi

if [[ "$action" == --once ]]; then
    parse_options "$@" || exit $?
    check_harness_cli || exit $?
    [[ ! -t 0 ]] || { usage; exit 2; }
    prompt="$(command cat)" || exit 1
    [[ -n "${prompt//[[:space:]]/}" ]] || { print -u2 "$helper: prompt is empty"; exit 2; }
    if [[ "$output_format" == json ]] && (( ! $+commands[jq] )); then
        print -u2 "$helper: jq is required for JSON output"
        exit 127
    fi
    result="$(launch once "$prompt")"
    rc=$?
    if (( rc == 0 )) && [[ -z "${result//[[:space:]]/}" ]]; then
        print -u2 "$helper: harness returned an empty response"
        rc=1
    fi
    if [[ "$output_format" == json ]]; then
        print -rn -- "$result" | jq -Rs --argjson code "$rc" '{result: ., exit_code: $code, is_error: ($code != 0)}'
    else
        print -r -- "$result"
    fi
    exit "$rc"
fi

if (( ! $+commands[tmux] )); then
    print -u2 "$helper: tmux is required"
    exit 127
fi

case "$action" in
    list)
        if (( $# != 0 )); then
            usage
            exit 2
        fi
        tmux list-sessions -F '#S' 2>/dev/null | command grep -E "^(${harness}${legacy:+|$legacy})-review-" || true
        ;;
    start)
        parse_options "$@" || exit $?
        check_harness_cli || exit $?
        if [[ -t 0 ]]; then
            usage
            exit 2
        fi
        scratch_dir="$(command mktemp -d "${TMPDIR:-/tmp}/${tmp}-tmux.XXXXXX")" || exit 1
        if ! command cat > "$scratch_dir/prompt.md"; then
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir" 2>/dev/null || true
            exit 1
        fi
        if [[ ! -s "$scratch_dir/prompt.md" ]]; then
            print -u2 "$helper: prompt is empty"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir"
            exit 2
        fi
        if (( $(command wc -c < "$scratch_dir/prompt.md") > 131072 )); then
            print -u2 "$helper: initial prompt exceeds 128 KiB; shorten it and send further context later"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir"
            exit 2
        fi
        if ! uuid="$(command uuidgen)"; then
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir"
            exit 1
        fi
        session="${prefix}${uuid:l}"
        if ! turn_dir="$(command mktemp -d "${TMPDIR:-/tmp}/${tmp}-turns.XXXXXX")" || \
            ! command cp -- "$scratch_dir/prompt.md" "$turn_dir/prompt"; then
            [[ -n "$turn_dir" ]] && command rm -rf -- "$turn_dir"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir"
            exit 1
        fi
        harness_env=()
        if [[ "$harness" == cursor ]]; then
            if ! node "${runner:h}/cursor-session.mjs" config "$turn_dir/cursor-config" || \
                ! conversation="$("$cursor_cli" --trust create-chat)" || \
                [[ -z "$conversation" || "$conversation" == *[^a-zA-Z0-9_-]* ]] || \
                ! print -r -- "$conversation" > "$turn_dir/conversation" || \
                ! node "${runner:h}/cursor-session.mjs" paths "$turn_dir" "$PWD" "$conversation"; then
                print -u2 "$helper: could not prepare the native Cursor conversation"
                command rm -rf -- "$turn_dir" "$scratch_dir"
                exit 1
            fi
            harness_env=(-e "CURSOR_AGENT_BIN=$cursor_cli")
        elif [[ "$harness" == muse ]]; then
            harness_env=(-e "MUSE_BIN=$muse_cli")
        fi
        if ! pane="$(tmux new-session -d -x 160 -y 48 -P -F '#{pane_id}' -s "$session" -c "$PWD" \
            -e CODEX_REVIEW_SUBAGENT_ACTIVE=1 -e REVIEW_SUBAGENT_TMUX_RUNNER=1 \
            -e REVIEW_SUBAGENT_TURN_DIR="$turn_dir" \
            "${harness_env[@]}" \
            -- "$runner" "$harness" __run "$scratch_dir")"; then
            command rm -rf -- "$turn_dir"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir"
            exit 1
        fi
        if ! tmux set-window-option -t "$session" remain-on-exit on || \
            ! tmux set-option -t "$session" @review_pane "$pane" || \
            ! tmux set-option -t "$session" @review_turn_dir "$turn_dir" || \
            ! tmux set-option -t "$session" @review_sent 0; then
            tmux kill-session -t "=$session" 2>/dev/null || true
            command rm -rf -- "$turn_dir"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir" 2>/dev/null || true
            exit 1
        fi
        if ! state_file="$(command mktemp "${TMPDIR:-/tmp}/${tmp}-paste.XXXXXX")" || \
            ! tmux set-option -t "$session" @review_paste_state "$state_file" || \
            ! tmux pipe-pane -t "$pane" "exec ${(qq)tracker} ${(qq)state_file}"; then
            tmux kill-session -t "=$session" 2>/dev/null || true
            [[ -n "$state_file" ]] && command rm -f -- "$state_file"
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir" 2>/dev/null || true
            exit 1
        fi
        if ! : > "$scratch_dir/ready"; then
            tmux kill-session -t "=$session" 2>/dev/null || true
            command rm -f -- "$scratch_dir/prompt.md"
            command rmdir -- "$scratch_dir" 2>/dev/null || true
            exit 1
        fi
        print -r -- "$session"
        ;;
    send|capture|status|interrupt|stop|wait)
        timeout=3600
        if [[ "$action" == wait && "${2:-}" == --timeout ]]; then
            if (( $# != 3 )) || [[ "$3" != <1-> ]]; then
                usage
                exit 2
            fi
            timeout="$3"
            set -- "$1"
        fi
        if (( $# != 1 )) || [[ "$1" != "$prefix"* && ( -z "$legacy" || "$1" != "$legacy-review-"* ) ]]; then
            usage
            exit 2
        fi
        session="$1"
        if ! tmux has-session -t "=$session" 2>/dev/null; then
            print -u2 "$helper: session is not running: $session"
            exit 1
        fi
        pane="$(tmux show-options -v -t "$session" @review_pane)" || exit 1
        if [[ "$pane" != %<-> ]]; then
            print -u2 "$helper: review pane is missing: $session"
            exit 1
        fi
        case "$action" in
            send)
                # Retain failed delivery across commands so wait cannot replay an older turn.
                tmux set-option -t "$session" @review_send_state pending || exit 1
                tmux set-option -t "$session" @review_auto_continued 0 || exit 1
                trap 'send_rc=$?; if (( send_rc != 0 && send_rc != 124 )); then tmux set-option -t "$session" @review_send_state failed 2>/dev/null || true; fi' EXIT
                if [[ -t 0 ]]; then
                    usage
                    exit 2
                fi
                message_file="$(command mktemp "${TMPDIR:-/tmp}/${tmp}-message.XXXXXX")" || exit 1
                if ! command cat > "$message_file"; then
                    command rm -f -- "$message_file"
                    exit 1
                fi
                if [[ ! -s "$message_file" ]]; then
                    print -u2 "$helper: message is empty"
                    command rm -f -- "$message_file"
                    exit 2
                fi
                if [[ "$(tmux display-message -p -t "$pane" '#{pane_dead}'):$(input_ready)" != 0:1 ]]; then
                    print -u2 "$helper: harness input is not ready; inspect the pane before sending"
                    command rm -f -- "$message_file"
                    exit 1
                fi
                if ! uuid="$(command uuidgen)"; then
                    command rm -f -- "$message_file"
                    exit 1
                fi
                buffer="${prefix}${uuid:l}"
                # `wait` returns only for a turn that finishes after this send.
                if [[ "$harness" == cursor ]]; then
                    turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir)" || exit 1
                    command rm -f -- "$turn_dir/error" "$turn_dir/partial"
                    if ! node "${runner:h}/cursor-session.mjs" mark-send "$turn_dir" "$message_file"; then
                        command rm -f -- "$message_file"
                        exit 1
                    fi
                fi
                if [[ "$harness" == muse ]]; then
                    turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir)" || exit 1
                    command rm -f -- "$turn_dir/error"
                fi
                if ! tmux set-option -t "$session" @review_sent "$(turns_done)"; then
                    command rm -f -- "$message_file"
                    exit 1
                fi
                if ! tmux load-buffer -b "$buffer" "$message_file"; then
                    command rm -f -- "$message_file"
                    exit 1
                fi
                command rm -f -- "$message_file"
                [[ "$harness" == cursor ]] && draft="$(cursor_draft)"
                if ! tmux paste-buffer -pr -d -b "$buffer" -t "$pane"; then
                    tmux delete-buffer -b "$buffer" 2>/dev/null || true
                    exit 1
                fi
                if [[ "$harness" == cursor ]]; then
                    # Cursor ignores an Enter that arrives just after a paste, leaving
                    # the draft (e.g. `[Pasted text #1 +9 lines]`) unsent.
                    deadline=$(( SECONDS + 3 ))
                    while [[ "$(cursor_draft)" == "$draft" ]] && (( SECONDS < deadline )); do
                        sleep 0.05
                    done
                    sleep 0.2
                    draft="$(cursor_draft)"
                fi
                tmux send-keys -t "$pane" Enter || exit 1
                tmux set-option -t "$session" @review_send_state submitted || exit 1
                if [[ "$harness" == cursor ]]; then
                    # Enter submits text; the queued-message footer offers another Enter
                    # to steer. Confirm its activation or transcript receipt; absence
                    # of a slowly rendered footer is not proof of delivery.
                    steering_sent=0
                    delivery_confirmed=0
                    deadline=$(( SECONDS + 10 ))
                    retry_at=$(( SECONDS + 1 ))
                    while (( SECONDS < deadline )); do
                        if [[ "$(tmux display-message -p -t "$pane" '#{pane_dead}' 2>/dev/null)" != 0 ]]; then
                            print -u2 "$helper: pane exited before message delivery was confirmed"
                            exit 1
                        fi
                        if [[ -s "$turn_dir/error" ]]; then
                            print -u2 -r -- "$helper: $(<"$turn_dir/error")"
                            exit 1
                        fi
                        screen="$(tmux capture-pane -p -t "$pane")" || exit 1
                        if (( ! steering_sent )) && print -r -- "$screen" | command grep -Eq "${cursor_footer}steer[[:space:]]*·"; then
                            tmux send-keys -t "$pane" Enter || exit 1
                            steering_sent=1
                        elif { (( steering_sent )) && print -r -- "$screen" | command grep -Eq "${cursor_footer}interrupt and send[[:space:]]*·"; } || \
                            node "${runner:h}/cursor-session.mjs" received "$turn_dir"; then
                            delivery_confirmed=1
                            break
                        elif (( ! steering_sent && SECONDS >= retry_at )) && [[ "$(cursor_draft)" == "$draft" ]]; then
                            # The draft is still unsent, so Enter submits it rather than interrupting.
                            tmux send-keys -t "$pane" Enter || exit 1
                            retry_at=$(( SECONDS + 1 ))
                        fi
                        sleep 0.1
                    done
                    if (( ! delivery_confirmed )); then
                        print -u2 "$helper: message delivery is unconfirmed after 10 seconds; it may still be queued. Inspect status/capture or wait; do not resend automatically."
                        exit 124
                    fi
                fi
                ;;
            capture) tmux capture-pane -p -S -300 -t "$pane" && turn_hint ;;
            status) print -r -- "$(tmux display-message -p -t "$pane" '#{session_name} pane=#{pane_id} dead=#{pane_dead} exit_code=#{pane_dead_status}') input_ready=$(input_ready)" && turn_hint ;;
            interrupt)
                if [[ "$harness" == cursor ]]; then
                    turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir)" || exit 1
                    command rm -f -- "$turn_dir/latest-message.json"
                    tmux send-keys -t "$pane" C-c
                elif [[ "$harness" == muse ]]; then
                    # Escape cancels the turn and restores it plus any queued input as one draft;
                    # the next paste would append to it, so clear it. Ctrl-C on an empty box would
                    # arm quitting instead, so press it only once the draft has appeared.
                    busy=0
                    muse_busy && busy=1
                    tmux send-keys -t "$pane" Escape
                    deadline=$(( SECONDS + 3 ))
                    while (( busy )) && [[ -z "$(muse_draft)" ]] && (( SECONDS < deadline )); do sleep 0.1; done
                    [[ -n "$(muse_draft)" ]] && tmux send-keys -t "$pane" C-c
                    # The cancelled turn fires no Stop, so only turns after the next send count.
                    tmux set-option -t "$session" @review_sent "$(turns_done)"
                else tmux send-keys -t "$pane" Escape; fi
                ;;
            wait)
                turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir)" || exit 1
                deadline=$(( SECONDS + timeout ))
                trust_since=-1
                while true; do
                    delivery="$(tmux show-options -v -t "$session" @review_send_state 2>/dev/null)" || delivery=submitted
                    if [[ "$delivery" == failed ]]; then
                        print -u2 "$helper: latest message delivery failed; no reply is available for that request"
                        exit 1
                    fi
                    sent="$(tmux show-options -v -t "$session" @review_sent)" || exit 1
                    if [[ "$delivery" != pending ]] && (( $(turns_done) > sent )) && \
                        [[ "$harness" != cursor || ! -e "$turn_dir/latest-message.json" ]] && \
                        { [[ "$harness" != muse ]] || ! muse_busy; }; then
                        if [[ "$harness" == muse && -s "$turn_dir/error" ]] && auto_continue "$(<"$turn_dir/error")"; then
                            continue
                        fi
                        break
                    fi
                    if [[ "$harness" == cursor && -s "$turn_dir/error" ]]; then
                        auto_continue "$(<"$turn_dir/error")" && continue
                        print -u2 -r -- "$helper: $(<"$turn_dir/error")"
                        if [[ -s "$turn_dir/partial" ]]; then
                            print -u2 "$helper: unverified text written before the failure:"
                            print -u2 -r -- "$(<"$turn_dir/partial")"
                        fi
                        exit 1
                    fi
                    if ! tmux has-session -t "=$session" 2>/dev/null || \
                        [[ "$(tmux display-message -p -t "$pane" '#{pane_dead}')" != 0 ]]; then
                        print -u2 "$helper: review pane exited before the turn finished: $session"
                        exit 1
                    fi
                    # Claude Code's workspace trust dialog blocks before any turn starts and fires no
                    # hook, so it would otherwise look like a running turn until the deadline. The
                    # launcher accepts it within seconds; one still showing after 10 is stuck.
                    if [[ "$harness" == (claude|ds) ]] && \
                        tmux capture-pane -p -t "$pane" | command grep -Fq 'Yes, I trust this folder'; then
                        (( trust_since >= 0 )) || trust_since=$SECONDS
                        if (( SECONDS - trust_since >= 10 )); then
                            print -u2 "$helper: Claude Code is stuck on its workspace trust dialog for $(tmux display-message -p -t "$pane" '#{pane_current_path}'); inspect \`$helper capture $session\`, then stop it"
                            exit 1
                        fi
                    else
                        trust_since=-1
                    fi
                    if (( SECONDS >= deadline )); then
                        print -u2 "$helper: no finished turn after $timeout seconds: $session"
                        exit 124
                    fi
                    # Cursor steers one queued message at a time; steer the next when offered.
                    if [[ "$harness" == cursor ]] && \
                        tmux capture-pane -p -t "$pane" | command grep -Eq "${cursor_footer}steer[[:space:]]*·"; then
                        tmux send-keys -t "$pane" Enter
                    fi
                    sleep 1
                done
                turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir)" || exit 1
                if [[ "$harness" == muse && -s "$turn_dir/error" ]]; then
                    print -u2 -r -- "$helper: $(<"$turn_dir/error")"
                    exit 1
                fi
                reply=''
                if [[ -r "$turn_dir/last" ]]; then
                    reply="$(<"$turn_dir/last")"
                fi
                if [[ -z "${reply//[[:space:]]/}" ]]; then
                    print -u2 "$helper: harness returned an empty reply"
                    exit 1
                fi
                print -r -- "$reply"
                ;;
            stop)
                turn_dir="$(tmux show-options -v -t "$session" @review_turn_dir 2>/dev/null)"
                tmux kill-session -t "=$session" || exit
                # Sessions started before the legacy entrypoints were removed use the old prefix.
                if [[ "$turn_dir" == */(${tmp}|${harness}-subagent|agent-team-${legacy:-$harness})-turns.* ]]; then
                    command rm -rf -- "$turn_dir"
                fi
                ;;
        esac
        ;;
    *)
        usage
        exit 2
        ;;
esac
