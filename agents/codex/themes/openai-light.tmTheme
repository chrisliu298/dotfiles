<?xml version="1.0" encoding="UTF-8"?>
<plist version="1.0">
<dict>
  <key>name</key><string>OpenAI Light</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>background</key><string>#ffffff</string>
        <key>foreground</key><string>#1f1f1f</string>
        <key>caret</key><string>#1f1f1f</string>
        <key>selection</key><string>#e8e8e8</string>
        <key>lineHighlight</key><string>#f7f7f7</string>
      </dict>
    </dict>
    <dict>
      <key>name</key><string>Comment</string>
      <key>scope</key><string>comment</string>
      <key>settings</key><dict><key>foreground</key><string>#707070</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Keyword</string>
      <key>scope</key><string>keyword, storage.type, storage.modifier</string>
      <key>settings</key><dict><key>foreground</key><string>#bf1831</string></dict>
    </dict>
    <dict>
      <key>name</key><string>String</string>
      <key>scope</key><string>string, markup.raw</string>
      <key>settings</key><dict><key>foreground</key><string>#005ed7</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Number and constant</string>
      <key>scope</key><string>constant.numeric, constant.language</string>
      <key>settings</key><dict><key>foreground</key><string>#956000</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Function</string>
      <key>scope</key><string>entity.name.function, support.function</string>
      <key>settings</key><dict><key>foreground</key><string>#722ccc</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Type</string>
      <key>scope</key><string>entity.name.type, support.type, support.class</string>
      <key>settings</key><dict><key>foreground</key><string>#007b87</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Inserted</string>
      <key>scope</key><string>markup.inserted</string>
      <key>settings</key><dict><key>foreground</key><string>#007a56</string></dict>
    </dict>
    <dict>
      <key>name</key><string>Deleted and invalid</string>
      <key>scope</key><string>markup.deleted, invalid</string>
      <key>settings</key><dict><key>foreground</key><string>#bf1831</string></dict>
    </dict>
  </array>
</dict>
</plist>
