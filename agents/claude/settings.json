{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "9007199254740991"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "effortLevel": "high",
  "language": "chinese",
  "autoCompactWindow": 400000,
  "subagentPromptCacheTtl": "1h",
  "autoMemoryEnabled": true,
  "cleanupPeriodDays": 3650000,
  "autoDreamEnabled": false,
  "skillListingBudgetFraction": 0.02,
  "syncClaudeAiSkills": false,
  "skillOverrides": {
    "artifact-capabilities": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "code-review": "off",
    "codex-exec": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "keybindings-help": "off",
    "loop": "off",
    "run": "off",
    "schedule": "off",
    "security-review": "off",
    "simplify": "off",
    "update-config": "off"
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "autoInstallIdeExtension": false,
  "voice": {
    "enabled": true
  },
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "DesignSync",
      "ReportFindings",
      "SendFeedback",
      "Agent(statusline-setup)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/presence/presence hook-ask" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/presence/presence hook-prompt" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/lang-guard.py post-tool" }]
      },
      {
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/presence/presence hook-post" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "python3 ~/.claude/lang-guard.py stop" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [{ "type": "command", "command": "bash ~/.claude/opus-repin.sh session-start" }]
      },
      {
        "matcher": "resume",
        "hooks": [{ "type": "command", "command": "bash ~/.claude/opus-repin.sh session-resume" }]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [{ "type": "command", "command": "bash ~/.claude/opus-repin.sh pre-switch" }]
      }
    ],
    "PostModelSwitch": [
      {
        "matcher": "claude-opus-5|claude-opus-5-5",
        "hooks": [{ "type": "command", "command": "bash ~/.claude/opus-repin.sh post-switch" }]
      }
    ]
  },
  "deniedMcpServers": [
    { "serverName": "claude.ai Google Drive" },
    { "serverName": "claude.ai Google Calendar" },
    { "serverName": "claude.ai Claude Docs" }
  ]
}
